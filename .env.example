# Keep subscriptions disabled until all three Brevo Worker secrets are set.
PUBLIC_SUBSCRIPTIONS_ENABLED=

# PostHog Cloud EU project token and ingestion host for the Brew Assistant.
# The phc_ token is a frontend ingestion key, not an administrative secret -
# but real values still belong in the deployment environment, not the repo.
# Never put a Personal API key in a PUBLIC_ variable.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Opt in to sending events from a local build. Off by default, so development
# never reaches the production project.
PUBLIC_ANALYTICS_ENABLED=

# Cloudflare Web Analytics. Create a site in the Cloudflare dashboard, pick the
# manual setup, and copy the token out of the snippet it offers. Its presence is
# the switch: the beacon and the privacy notice's visitor-statistics section
# both appear only when this is set. PUBLIC_, so it is baked in at build time.
PUBLIC_WEB_ANALYTICS_TOKEN=
