# PostHog Cloud EU project token and ingestion host for the Brew Assistant.
# The phc_ token is a frontend ingestion key, not an administrative secret —
# but real values still belong in the deployment environment, not the repo.
# Never put a Personal API key in a PUBLIC_ variable.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Opt in to sending events from a local build. Off by default, so development
# never reaches the production project.
PUBLIC_ANALYTICS_ENABLED=
