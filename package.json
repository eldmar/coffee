{
  "name": "daily-brew",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && echo \"--- astro build finished, running check ---\" && node scripts/check-build.mjs --warn-only",
    "preview": "astro preview",
    "astro": "astro",
    "images": "node scripts/build-images.mjs",
    "social-images": "node scripts/build-social-images.mjs",
    "check:en-gb": "node scripts/check-en-gb.mjs",
    "check:worker": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log wrangler deploy --dry-run",
    "verify": "npm run check:en-gb && vitest run && astro build && node scripts/check-build.mjs && npm run check:worker",
    "test": "vitest run",
    "deploy": "npm run verify && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.1",
    "posthog-js": "^1.414.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.3.4",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
