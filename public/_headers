# Cloudflare reads this file to set response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  # Both hostnames have served HTTPS only for a long time, and the Worker
  # 301s http:// and www. to the canonical origin, so a year is safe. The
  # `preload` directive is deliberately absent: it commits the domain to the
  # browser preload list, which is a separate decision and slow to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 'unsafe-inline' is still needed for JSON-LD blocks and Astro's inline island
  # bootstrap. Tighten to nonces once the newsletter Function is in place.
  # PostHog is allowed only where it is actually needed: the SDK script and the
  # ingestion endpoint. Nothing else about the policy is widened for it.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.posthog.com; connect-src 'self' https://*.posthog.com; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Astro fingerprints these, and scripts/build-images.mjs puts a content hash in
# every photo file name — replacing a photo changes its URL, so a year-long
# immutable cache can never serve a stale one.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# The worker script and the manifest decide what every other cache does, so
# they must never be served from a stale one themselves.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Data files the islands fetch instead of carrying as props. Plain names, so
# they cannot be immutable, but an hour of freshness plus background
# revalidation means a browsing session never waits on either of them.
/recipes-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/learn-paths.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Logo and icons still have plain names, so they get a short cache with
# background revalidation until the names carry a version too.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML is intentionally not listed: Cloudflare already serves it as
# `public, max-age=0, must-revalidate`, and adding a /* rule here would
# override the immutable rules above.
