---
import { getCollection } from 'astro:content';
import { methodIcons } from '../lib/methodIcons';

const guides = await getCollection('guides');
// Ordered by how most people meet them, not alphabetically.
const order = ['espresso', 'aeropress', 'v60', 'french-press', 'moka-pot'];
const sorted = order
  .map((m) => guides.find((g) => g.data.method === m))
  .filter((g) => g !== undefined);

---

<section class="bg-ivory">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <div>
        <span class="eyebrow">Brewing methods</span>
        <h2 class="mt-2 font-display text-3xl font-medium">Choose your brew method</h2>
      </div>
      <a href="/guides/" class="group text-sm font-medium text-accent hover:underline">
        Compare all methods
        <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">&#8594;</span>
      </a>
    </div>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Each brewer shapes the same coffee differently. Compare cup style, brew time and the kind of
      routine each method suits.
    </p>

    {/* Five cards over a three-column grid: three on the first row, two on the second. */}
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((guide) => (
          <li class="flex">
            <a
              href={`/guides/${guide.id}/`}
              class="group flex flex-1 flex-col rounded-lg border border-line bg-card p-6 transition duration-200 hover:border-ink/25 hover:shadow-md motion-safe:hover:-translate-y-0.5"
            >
              <span class="flex h-[68px] w-[68px] items-center justify-center rounded-full bg-paper text-ink">
                <svg
                  width="44"
                  height="44"
                  viewBox="0 0 48 48"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  aria-hidden="true"
                  set:html={methodIcons[guide.data.method]}
                />
              </span>

              <h3 class="mt-4 font-display text-xl font-medium">{guide.data.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{guide.data.summary}</p>

              <dl class="mt-5 flex flex-col gap-2.5 border-t border-line pt-4 text-sm">
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">Cup style</dt>
                  <dd class="text-right font-medium">{guide.data.cupStyle}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-3 border-t border-line pt-2.5">
                  <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">Brew time</dt>
                  <dd class="text-right font-medium">{guide.data.brewTime}</dd>
                </div>
                <div class="flex items-baseline justify-between gap-3 border-t border-line pt-2.5">
                  <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">Best for</dt>
                  <dd class="text-right font-medium">{guide.data.bestFor}</dd>
                </div>
              </dl>

              {/* mt-auto pins the call to action to the bottom whatever the summary length. */}
              <span class="mt-auto pt-5 text-sm font-medium text-accent">
                View {guide.data.title} guide
                <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">
                  &#8594;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 rounded-lg border border-line bg-card p-6">
      <h3 class="font-display text-xl font-medium">Not sure where to start?</h3>
      <ul class="mt-4 flex flex-col gap-2 text-sm">
        {
          sorted.map((guide) => (
            <li>
              <a
                href={`/guides/${guide.id}/`}
                class="group flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-ink-soft hover:text-ink"
              >
                <span>{guide.data.intent}</span>
                <span aria-hidden="true">&#8594;</span>
                <span class="font-medium text-accent group-hover:underline">{guide.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
