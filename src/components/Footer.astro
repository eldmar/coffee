---
import { LEARN_PATHS, pathHref } from '../lib/learn';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Explore',
    links: [
      { label: 'Recipes', href: '/recipes/' },
      { label: 'Brew Guides', href: '/guides/' },
      { label: 'Learn', href: '/learn/' },
      { label: 'Journal', href: '/journal/' },
      { label: 'Shop', href: '/shop/' },
    ],
  },
  {
    heading: 'Learn',
    links: [
      // Titles and destinations follow the paths themselves, so a path that
      // gets published stops pointing at a hub anchor on its own.
      ...LEARN_PATHS.map((path) => ({ label: path.title, href: pathHref(path) })),
      { label: 'All learning paths', href: '/learn/' },
    ],
  },
  {
    heading: 'About',
    links: [
      { label: 'Our story', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Journal', href: '/journal/' },
    ],
  },
  {
    // TODO: add Instagram and YouTube once the real KAVOVO profile URLs exist.
    heading: 'Connect',
    links: [
      { label: 'Newsletter', href: '/#newsletter' },
      { label: 'Accessibility', href: '/accessibility/' },
    ],
  },
];
---

<footer class="border-t border-line bg-paper">
  <div
    class="mx-auto grid max-w-6xl justify-items-center gap-10 px-5 py-12 text-center md:grid-cols-[1.2fr_repeat(4,1fr)] md:justify-items-start md:text-left"
  >
    <div>
      <img
        src="/images/kavovo-lockup.svg"
        alt="KAVOVO"
        width="1191"
        height="156"
        class="mx-auto h-7 w-auto md:mx-0"
      />
      <p class="mt-3 text-sm text-ink-soft">Better coffee at home.<br />Every day.</p>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.heading}>
        <h3 class="eyebrow">{col.heading}</h3>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ink">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-5 gap-y-2 px-5 py-4 text-xs text-ink-soft md:justify-between"
    >
      <p>&copy; {year} KAVOVO. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/terms/" class="hover:text-ink">Terms</a>
        <a href="/privacy/" class="hover:text-ink">Privacy</a>
        <a href="/accessibility/" class="hover:text-ink">Accessibility</a>
      </div>
    </div>
  </div>
</footer>
