---
const nav = [
  { label: 'Brew Guides', href: '/guides/' },
  { label: 'Learn', href: '/learn/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'Shop', href: '/shop/' },
];
const { pathname } = Astro.url;
const recipesActive = pathname.startsWith('/recipes/');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3.5 lg:gap-6">
    <a href="/" class="shrink-0" aria-label="KAVOVO — home">
      <img
        src="/images/kavovo-lockup.svg"
        alt="KAVOVO"
        width="1191"
        height="156"
        class="h-5 w-auto sm:h-6"
      />
    </a>

    <nav class="hidden flex-1 justify-center gap-6 text-sm text-ink-soft lg:flex" aria-label="Main">
      <div class="relative" data-recipes-menu>
        <button
          type="button"
          data-recipes-menu-toggle
          aria-expanded="false"
          aria-controls="recipes-menu-panel"
          class:list={[
            'inline-flex items-center gap-1.5 transition-colors hover:text-ink',
            recipesActive && 'font-medium text-ink',
          ]}
        >
          Recipes
          <svg
            data-recipes-menu-chevron
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div
          id="recipes-menu-panel"
          data-recipes-menu-panel
          hidden
          class="absolute left-1/2 top-full z-50 mt-3 w-52 -translate-x-1/2 rounded-md border border-line bg-card p-1.5 shadow-lg"
        >
          <a
            href="/recipes/"
            aria-current={pathname === '/recipes/' ? 'page' : undefined}
            class:list={[
              'flex min-h-10 items-center rounded px-3 text-sm transition-colors hover:bg-ivory hover:text-ink',
              pathname === '/recipes/' ? 'bg-ivory font-medium text-ink' : 'text-ink-soft',
            ]}
          >
            All recipes
          </a>
          <a
            href="/recipes/saved/"
            data-saved-link
            aria-current={pathname === '/recipes/saved/' ? 'page' : undefined}
            class:list={[
              'flex min-h-10 items-center justify-between gap-3 rounded px-3 text-sm transition-colors hover:bg-ivory hover:text-ink',
              pathname === '/recipes/saved/' ? 'bg-ivory font-medium text-ink' : 'text-ink-soft',
            ]}
          >
            <span>Saved recipes</span>
            <span
              data-saved-count
              hidden
              class="inline-flex min-w-5 items-center justify-center rounded-full bg-paper px-1.5 py-0.5 text-[11px] font-semibold text-ink"
            />
          </a>
        </div>
      </div>

      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'inline-flex items-center transition-colors hover:text-ink',
            pathname.startsWith(item.href) && 'font-medium text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <form action="/search/" method="get" class="hidden items-center lg:flex" role="search">
      <label class="flex items-center gap-2 field-shell rounded-full border border-line bg-card px-3.5 py-1.5 text-sm text-ink-soft transition-shadow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search all KAVOVO"
          aria-label="Search recipes, guides, learning paths and journal articles"
          class="w-40 bg-transparent placeholder:text-ink-soft"
        />
      </label>
      <button type="submit" class="sr-only">Search</button>
    </form>

    <a
      href="/recipes/"
      class="ml-auto hidden rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark sm:block lg:ml-0"
    >
      Explore recipes
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="ml-auto flex h-10 w-10 items-center justify-center rounded-md border border-line text-ink sm:ml-0 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg id="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="burger-line" d="M4 7h16" />
        <path class="burger-line" d="M4 12h16" />
        <path class="burger-line" d="M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden">
    <div class="menu-clip">
      <div class="menu-inner mx-auto flex max-w-6xl flex-col gap-1 border-t border-line px-5 py-4">
      <form action="/search/" method="get" role="search" class="mb-3">
        <label class="field-shell flex items-center gap-2 rounded-md border border-line bg-card px-3.5 py-2.5 text-sm text-ink-soft transition-shadow">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search all KAVOVO"
            aria-label="Search recipes, guides, learning paths and journal articles"
            class="w-full bg-transparent placeholder:text-ink-soft"
          />
        </label>
        <button type="submit" class="sr-only">Search</button>
      </form>
      <div data-mobile-recipes-menu>
        <button
          type="button"
          data-mobile-recipes-toggle
          aria-expanded={String(recipesActive)}
          aria-controls="mobile-recipes-panel"
          class:list={[
            'flex min-h-11 w-full items-center justify-between rounded-md px-3 text-[15px] font-medium transition-colors hover:bg-ivory',
            recipesActive ? 'bg-ivory text-ink' : 'text-ink-soft',
          ]}
        >
          Recipes
          <svg
            data-mobile-recipes-chevron
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div
          id="mobile-recipes-panel"
          data-mobile-recipes-panel
          hidden={!recipesActive}
          class="mt-1 space-y-1 border-l border-line pl-3"
        >
          <a
            href="/recipes/"
            aria-current={pathname === '/recipes/' ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-md px-3 text-sm transition-colors hover:bg-ivory',
              pathname === '/recipes/' ? 'font-medium text-ink' : 'text-ink-soft',
            ]}
          >
            All recipes
          </a>
          <a
            href="/recipes/saved/"
            data-saved-link
            aria-current={pathname === '/recipes/saved/' ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center justify-between gap-3 rounded-md px-3 text-sm transition-colors hover:bg-ivory',
              pathname === '/recipes/saved/' ? 'font-medium text-ink' : 'text-ink-soft',
            ]}
          >
            <span>Saved recipes</span>
            <span
              data-saved-count
              hidden
              class="inline-flex min-w-6 items-center justify-center rounded-full bg-card px-1.5 py-0.5 text-xs font-semibold text-ink"
            />
          </a>
        </div>
      </div>

      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center rounded-md px-3 py-2.5 text-[15px] font-medium transition-colors hover:bg-ivory',
            pathname.startsWith(item.href) ? 'bg-ivory text-ink' : 'text-ink-soft',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/recipes/"
        class="mt-3 rounded-md bg-accent px-4 py-2.5 text-center text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark sm:hidden"
      >
        Explore recipes
      </a>
      </div>
    </div>
  </div>
</header>

<style>
  #mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  #mobile-menu.open {
    grid-template-rows: 1fr;
  }
  .menu-clip {
    overflow: hidden;
    min-height: 0;
    visibility: hidden;
    transition: visibility 0s linear 0.3s;
  }
  #mobile-menu.open .menu-clip {
    visibility: visible;
    transition-delay: 0s;
  }
  .menu-inner {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.3s ease;
  }
  #mobile-menu.open .menu-inner {
    opacity: 1;
    transform: none;
    transition-delay: 0.05s;
  }
  .burger-line {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }
  [data-recipes-menu-chevron],
  [data-mobile-recipes-chevron] {
    transition: transform 0.2s ease;
  }
  [data-recipes-menu-toggle][aria-expanded='true'] [data-recipes-menu-chevron],
  [data-mobile-recipes-toggle][aria-expanded='true'] [data-mobile-recipes-chevron] {
    transform: rotate(180deg);
  }
  #menu-toggle.open .burger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }
  #menu-toggle.open .burger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  #menu-toggle.open .burger-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }
  @media (min-width: 1024px) {
    #mobile-menu {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    .menu-clip,
    .menu-inner,
    .burger-line,
    [data-recipes-menu-chevron],
    [data-mobile-recipes-chevron] {
      transition: none !important;
    }
  }
</style>

<script>
  import {
    RETENTION_KEYS,
    getSavedRecipes,
    subscribeRetentionKey,
  } from '../lib/retention/storage';

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const recipesMenu = document.querySelector<HTMLElement>('[data-recipes-menu]');
  const recipesMenuToggle = document.querySelector<HTMLButtonElement>('[data-recipes-menu-toggle]');
  const recipesMenuPanel = document.querySelector<HTMLElement>('[data-recipes-menu-panel]');
  const mobileRecipesToggle = document.querySelector<HTMLButtonElement>('[data-mobile-recipes-toggle]');
  const mobileRecipesPanel = document.querySelector<HTMLElement>('[data-mobile-recipes-panel]');

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle('open', open);
    toggle.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    setMenu(!menu?.classList.contains('open'));
  });

  function setRecipesMenu(open: boolean) {
    if (!recipesMenuToggle || !recipesMenuPanel) return;
    recipesMenuToggle.setAttribute('aria-expanded', String(open));
    recipesMenuPanel.hidden = !open;
  }

  recipesMenuToggle?.addEventListener('click', () => {
    setRecipesMenu(recipesMenuToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (event) => {
    if (recipesMenu && event.target instanceof Node && !recipesMenu.contains(event.target)) {
      setRecipesMenu(false);
    }
  });

  recipesMenu?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !recipesMenu.contains(event.relatedTarget)) {
      setRecipesMenu(false);
    }
  });

  function setMobileRecipesMenu(open: boolean) {
    if (!mobileRecipesToggle || !mobileRecipesPanel) return;
    mobileRecipesToggle.setAttribute('aria-expanded', String(open));
    mobileRecipesPanel.hidden = !open;
  }

  mobileRecipesToggle?.addEventListener('click', () => {
    setMobileRecipesMenu(mobileRecipesToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (recipesMenuToggle?.getAttribute('aria-expanded') === 'true') {
      setRecipesMenu(false);
      recipesMenuToggle.focus();
      return;
    }
    if (menu?.classList.contains('open')) {
      setMenu(false);
      toggle?.focus();
    }
  });

  function refreshSavedCount() {
    const count = getSavedRecipes().items.length;
    for (const badge of document.querySelectorAll<HTMLElement>('[data-saved-count]')) {
      badge.textContent = String(count);
      badge.hidden = count === 0 && !badge.hasAttribute('data-show-zero');
    }
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-saved-link]')) {
      const includeZero = link.hasAttribute('data-show-zero');
      link.setAttribute(
        'aria-label',
        count > 0 || includeZero ? `Saved recipes, ${count}` : 'Saved recipes',
      );
    }
  }

  refreshSavedCount();
  subscribeRetentionKey(RETENTION_KEYS.savedRecipes, refreshSavedCount);
</script>
