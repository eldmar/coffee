---
---

<section
  class="relative overflow-hidden bg-cream md:h-[min(56.25vw,calc(100vh-4rem))] md:min-h-[640px] lg:min-h-[680px]"
>
  <img
    src="/images/hero.jpg"
    alt=""
    class="absolute inset-0 hidden h-full w-full object-cover object-right md:block"
    width="1920"
    height="1080"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 hidden bg-gradient-to-r from-cream via-cream/70 to-transparent md:block lg:via-cream/40 lg:to-55%"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto max-w-6xl px-5 pt-14 pb-10 md:flex md:h-full md:items-center md:pt-0 md:pb-32"
  >
    <div class="max-w-md">
      <h1 class="font-display text-5xl leading-[1.08] font-medium text-balance md:text-6xl">
        Better coffee starts here.
      </h1>
      <p class="mt-5 max-w-sm text-lg text-ink-soft">
        Simple recipes, practical guides, and the confidence to brew your best cup at home.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/recipes"
          class="rounded-md bg-clay px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-clay-dark"
        >
          Find a recipe
        </a>
        <a
          href="/learn"
          class="rounded-md border border-ink/25 bg-paper/60 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink/50"
        >
          Start with the basics
        </a>
      </div>
    </div>
  </div>
  <img
    src="/images/hero.jpg"
    alt="Latte with rosetta art beside a pour-over brewing on a wooden table"
    class="h-72 w-full object-cover object-[70%_center] sm:h-80 md:hidden"
    width="1920"
    height="1080"
  />
</section>
