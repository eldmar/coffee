---
import Photo from './Photo.astro';
---

<section
  class="relative overflow-hidden bg-ivory md:h-[min(56.25vw,calc(100vh-4rem))] md:min-h-[640px] lg:min-h-[680px]"
>
  <Photo
    name="hero"
    alt=""
    sizes="100vw"
    class="absolute inset-0 hidden h-full w-full object-cover object-right md:block"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 hidden bg-gradient-to-r from-ivory via-ivory/70 to-transparent md:block lg:via-ivory/40 lg:to-55%"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto max-w-6xl px-5 pt-14 pb-10 md:flex md:h-full md:items-center md:pt-0 md:pb-32"
  >
    <div class="max-w-md">
      <h1 class="font-display text-5xl leading-[1.08] font-medium text-balance md:text-6xl">
        Coffee, made clear.
      </h1>
      <p class="mt-5 text-lg text-ink-soft">
        Straightforward drink recipes, practical brewing guides and, soon, coffee chosen for the way you brew.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/recipes/"
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
        >
          Find a recipe
        </a>
        <a
          href="/learn/"
          class="rounded-md border border-ink/25 bg-paper/60 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink/50"
        >
          Learn to brew
        </a>
      </div>
    </div>
  </div>
  <Photo
    name="hero"
    alt="Latte with rosetta art beside a pour-over brewing on a wooden table"
    sizes="100vw"
    class="h-72 w-full object-cover object-[70%_center] sm:h-80 md:hidden"
    loading="eager"
    fetchpriority="high"
  />
</section>
