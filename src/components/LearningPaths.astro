---
const paths = [
  {
    title: 'Coffee basics',
    description: 'Start here. Essential knowledge and simple recipes.',
    image: '/images/learn-basics.jpg',
    href: '/learn#basics',
  },
  {
    title: 'Dial in espresso',
    description: 'Dial in with confidence and consistency.',
    image: '/images/learn-espresso.jpg',
    href: '/learn#espresso',
  },
  {
    title: 'Understand your beans',
    description: 'Origin, processing, roast, and flavor.',
    image: '/images/learn-beans.jpg',
    href: '/learn#beans',
  },
];
---

<section class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-16 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.6fr)]">
  <div>
    <span class="eyebrow">New to coffee?</span>
    <h2 class="mt-3 font-display text-3xl font-medium text-balance">From beans to brew</h2>
    <p class="mt-4 max-w-xs text-ink-soft">
      A clear beginner path that walks you through everything—from choosing your beans to brewing a cup you'll love.
    </p>
    <a
      href="/learn"
      class="mt-6 inline-block rounded-md border border-ink/25 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink/50"
    >
      Start the beginner path
    </a>
    <p class="mt-6 flex items-center gap-2 text-sm text-ink-soft">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 5a2 2 0 0 1 2-2h5v18H6a2 2 0 0 1-2-2V5Zm16 0a2 2 0 0 0-2-2h-5v18h5a2 2 0 0 0 2-2V5Z" />
      </svg>
      3 paths · Guided lessons · Practical tips
    </p>
  </div>

  <div>
    <div class="grid gap-4 sm:grid-cols-3">
      {paths.map((path) => (
        <a
          href={path.href}
          class="group flex flex-col overflow-hidden rounded-lg border border-line bg-card transition-shadow hover:shadow-md"
        >
          <img src={path.image} alt="" class="aspect-[4/3] w-full object-cover" width="300" height="225" loading="lazy" />
          <div class="flex flex-1 flex-col p-4">
            <h3 class="font-medium">{path.title}</h3>
            <p class="mt-1 text-sm text-ink-soft">{path.description}</p>
            <span class="mt-3 text-sm font-medium text-clay">
              Start path
              <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">&#8594;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-6 text-center">
      <a href="/learn" class="text-sm font-medium text-clay hover:underline">Browse all learning paths &#8594;</a>
    </p>
  </div>
</section>
