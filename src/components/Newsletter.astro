---
interface Props {
  source?: 'homepage-newsletter';
}

const { source = 'homepage-newsletter' } = Astro.props;
const subscriptionsEnabled = import.meta.env.PUBLIC_SUBSCRIPTIONS_ENABLED === 'true';

import SubscribeForm from './SubscribeForm.astro';
---

<section class="on-brand bg-sage text-ivory">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-14 md:grid-cols-2">
    <div class="flex items-start gap-5">
      <span
        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-ivory/15 text-ivory"
        aria-hidden="true"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </span>
      <div>
        <h2 class="font-display text-3xl leading-snug font-medium text-balance">
          Brew ideas,<br />straight to your inbox
        </h2>
        <p class="mt-3 max-w-sm text-ivory">
          Weekly recipes, guides, and coffee stories worth waking up for.
        </p>
      </div>
    </div>
    <div>
      {
        subscriptionsEnabled ? (
          <>
            <SubscribeForm
              id="newsletter"
              source={source}
              submitLabel="Subscribe"
              variant="brand"
            />
            <p class="mt-1 text-xs text-ivory">
              No spam. Unsubscribe anytime. See our&#32;
              <a href="/privacy/" class="underline underline-offset-2 hover:text-ivory">
                privacy notice
              </a>
              .
            </p>
          </>
        ) : (
          <p class="text-sm font-medium text-ivory">Newsletter coming soon.</p>
        )
      }
    </div>
  </div>
</section>
