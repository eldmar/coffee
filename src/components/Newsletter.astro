---
interface Props {
  source?: string;
}

const { source = 'homepage-newsletter' } = Astro.props;
---

<section class="bg-sage text-ivory">
  <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-14 md:grid-cols-2">
    <div class="flex items-start gap-5">
      <span
        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-ivory/15 text-ivory"
        aria-hidden="true"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </span>
      <div>
        <h2 class="font-display text-3xl leading-snug font-medium text-balance">
          Brew ideas,<br />straight to your inbox
        </h2>
        <p class="mt-3 max-w-sm text-ivory/85">
          Weekly recipes, guides, and coffee stories worth waking up for.
        </p>
      </div>
    </div>
    <div>
      <!-- TODO: /api/subscribe still needs its Cloudflare Function and Brevo credentials -->
      <form method="post" action="/api/subscribe" class="flex flex-col gap-3 sm:flex-row">
        <input type="hidden" name="source" value={source} />
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="Your email address"
          class="flex-1 rounded-md border border-transparent bg-paper px-4 py-2.5 text-sm text-ink outline-none focus:border-ivory"
        />
        <button
          type="submit"
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-2.5 text-xs text-ivory/75">
        No spam. Unsubscribe anytime. See our&#32;<a
          href="/privacy/"
          class="underline underline-offset-2 hover:text-ivory">privacy notice</a
        >.
      </p>
    </div>
  </div>
</section>
