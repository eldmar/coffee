---
import { photo, srcset } from '../lib/photos';

interface Props {
  /** Manifest key, i.e. the source file name without extension. */
  name: string;
  alt: string;
  sizes: string;
  class?: string;
  /**
   * Styles the <picture> rather than the <img>. Needed whenever the photo is a
   * flex or grid item: the <picture> is the item that gets sized, so a width on
   * the <img> alone is ignored and the thumbnail sizes itself.
   */
  pictureClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto' | 'low';
}

const {
  name,
  alt,
  sizes,
  class: className,
  pictureClass,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;

const entry = photo(name);
---

<picture class={pictureClass}>
  <source type="image/avif" srcset={srcset(entry.avif)} sizes={sizes} />
  <source type="image/webp" srcset={srcset(entry.webp)} sizes={sizes} />
  <img
    src={entry.src}
    alt={alt}
    width={entry.width}
    height={entry.height}
    class:list={[className, loading === 'lazy' && 'bg-line']}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
