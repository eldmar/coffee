---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { categoryLabel, formatTimeShort } from '../lib/recipes';

interface Props {
  slug: string;
  title: string;
  image: ImageMetadata;
  category: string;
  activeTime: number;
  totalTime: number;
  totalTimeLabel?: string;
  difficulty: string;
}

const { slug, title, image, category, activeTime, totalTime, totalTimeLabel, difficulty } =
  Astro.props;

const difficultyLabels: Record<string, string> = {
  easy: 'Easy',
  medium: 'Medium',
  hard: 'Hard',
};

const timeLabel = formatTimeShort({ activeTime, totalTime, totalTimeLabel });
---

<a
  href={`/recipes/${slug}/`}
  class="group flex flex-col overflow-hidden rounded-lg border border-line bg-card transition-shadow hover:shadow-md"
>
  <Picture
    src={image}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 640, 800]}
    sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
    class="aspect-[4/3] w-full object-cover"
    loading="lazy"
    decoding="async"
  />
  <div class="flex flex-1 flex-col gap-1.5 p-5">
    <span class="eyebrow">{categoryLabel(category)}</span>
    <h3 class="font-display text-xl font-medium">{title}</h3>
    <div class="mt-auto flex items-center gap-2 pt-2 text-sm text-ink-soft">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </svg>
      <span>{timeLabel}</span>
      <span aria-hidden="true">·</span>
      <span class:list={[difficulty === 'medium' && 'text-accent', difficulty === 'hard' && 'text-accent']}>
        {difficultyLabels[difficulty] ?? difficulty}
      </span>
      <span
        class="ml-auto text-accent transition-transform group-hover:translate-x-1"
        aria-hidden="true"
      >
        &#8594;
      </span>
    </div>
  </div>
</a>
