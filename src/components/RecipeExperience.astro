---
interface Props {
  title: string;
  steps: string[];
  baseCups?: number;
  cupNote?: string;
  batchScaling?: boolean;
}

const { title, steps, baseCups, cupNote, batchScaling = false } = Astro.props;
const hasCupScaling = typeof baseCups === 'number';
const stepTotal = Math.max(steps.length, 1);
---

<div
  data-recipe-experience
  data-base-cups={hasCupScaling ? baseCups : undefined}
  data-cup-note-text={cupNote}
  data-batch-scaling={batchScaling ? 'true' : 'false'}
>
  <div data-recipe-tools hidden class="recipe-tools print:hidden">
    <div class="recipe-tools__copy">
      <p class="text-sm font-medium text-ink">Tap each step as you brew.</p>
      <p data-cup-status class="mt-1 text-xs text-ink-soft" aria-live="polite"></p>
      <p data-cup-note hidden class="mt-2 max-w-xl text-xs leading-relaxed text-ink-soft"></p>
    </div>

    <div class="recipe-tools__actions">
      {
        hasCupScaling && (
          <fieldset class="recipe-cups">
            <legend class="text-xs font-medium text-ink-soft">Cups</legend>
            <div class="recipe-cups__options" aria-label="Number of cups">
              {[1, 2, 3].map((cups) => (
                <button
                  type="button"
                  data-cups={cups}
                  aria-pressed={cups === baseCups ? 'true' : 'false'}
                  class="recipe-cups__button"
                >
                  {cups}
                </button>
              ))}
            </div>
          </fieldset>
        )
      }

      <button type="button" data-reset-steps class="recipe-tool-button" disabled>
        Reset steps
      </button>
      <button type="button" data-open-brew-mode class="recipe-tool-button recipe-tool-button--primary">
        Brew mode
      </button>
    </div>
    <span data-step-status class="sr-only" role="status" aria-live="polite"></span>
  </div>

  <dialog
    data-brew-dialog
    class="recipe-brew-dialog print:hidden"
    aria-labelledby="recipe-brew-title"
  >
    <div class="recipe-brew-dialog__layout">
      <header class="recipe-brew-dialog__header">
        <div class="min-w-0">
          <p class="eyebrow">Brew mode</p>
          <h2 id="recipe-brew-title" class="mt-1 truncate font-display text-xl font-medium">
            {title}
          </h2>
        </div>
        <button
          type="button"
          data-close-brew-mode
          class="recipe-icon-button"
          aria-label="Close brew mode"
          title="Close brew mode"
        >
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <section class="recipe-brew-timer" aria-label="Brew timer">
        <div>
          <p class="text-xs font-medium text-ink-soft">Timer</p>
          <time data-brew-time datetime="PT0S" class="recipe-brew-timer__time">00:00</time>
        </div>
        <div class="recipe-brew-timer__actions">
          <button type="button" data-toggle-timer class="recipe-tool-button recipe-tool-button--primary">
            Start timer
          </button>
          <button type="button" data-reset-timer class="recipe-tool-button">Reset timer</button>
        </div>
      </section>

      <div class="recipe-wake-row">
        <label data-wake-control hidden class="recipe-wake-control">
          <input type="checkbox" data-keep-awake class="size-4 accent-[var(--color-accent)]" />
          <span>Keep screen awake</span>
        </label>
        <span data-wake-status class="text-xs text-ink-soft" role="status" aria-live="polite"></span>
      </div>

      <section class="recipe-brew-step" aria-labelledby="recipe-current-step">
        <div class="flex items-center justify-between gap-4">
          <p data-step-count class="text-sm font-medium text-accent">Step 1 of {stepTotal}</p>
          <p data-step-complete class="text-xs text-ink-soft"></p>
        </div>
        <progress data-step-progress max={stepTotal} value="1" class="recipe-brew-progress">
          Step 1 of {stepTotal}
        </progress>
        <h3 id="recipe-current-step" data-current-step tabindex="-1" class="recipe-brew-step__text">
          {steps[0] ?? 'Follow the recipe steps below.'}
        </h3>
      </section>

      <footer class="recipe-brew-dialog__footer">
        <button type="button" data-previous-step class="recipe-tool-button">Previous</button>
        <button
          type="button"
          data-next-step
          class="recipe-tool-button recipe-tool-button--primary"
        >
          Mark done & next
        </button>
      </footer>
    </div>
  </dialog>
</div>

<style is:global>
  .recipe-tools {
    margin: 0 0 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .recipe-tools__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.625rem;
    margin-top: 0.875rem;
  }

  .recipe-cups {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .recipe-cups__options {
    display: inline-grid;
    grid-template-columns: repeat(3, 2.75rem);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .recipe-cups__button {
    display: grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border: 0;
    border-left: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .recipe-cups__button:first-child {
    border-left: 0;
  }

  .recipe-cups__button[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .recipe-tool-button,
  .recipe-icon-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .recipe-tool-button {
    padding: 0 1rem;
  }

  .recipe-tool-button:hover:not(:disabled),
  .recipe-icon-button:hover {
    border-color: var(--color-accent);
    background: var(--color-ivory);
  }

  .recipe-tool-button--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .recipe-tool-button--primary:hover:not(:disabled) {
    border-color: var(--color-accent-dark);
    background: var(--color-accent-dark);
  }

  .recipe-tool-button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .recipe-tool-button:focus-visible,
  .recipe-icon-button:focus-visible,
  .recipe-cups__button:focus-visible,
  .recipe-step-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .recipe-icon-button {
    width: 44px;
    flex: 0 0 44px;
    padding: 0;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
  }

  .recipe-brew-dialog {
    width: min(45rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0;
    background: var(--color-card);
    color: var(--color-ink);
    box-shadow: 0 24px 64px rgb(43 33 27 / 0.22);
  }

  .recipe-brew-dialog::backdrop {
    background: rgb(43 33 27 / 0.58);
  }

  .recipe-brew-dialog__layout {
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    max-height: calc(100dvh - 2rem);
    overflow: hidden;
  }

  .recipe-brew-dialog__header,
  .recipe-brew-dialog__footer,
  .recipe-brew-timer,
  .recipe-wake-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .recipe-brew-dialog__footer {
    border-top: 1px solid var(--color-line);
    border-bottom: 0;
  }

  .recipe-brew-dialog__footer .recipe-tool-button {
    min-width: 7.5rem;
  }

  .recipe-brew-timer {
    background: var(--color-ivory);
  }

  .recipe-brew-timer__time {
    display: block;
    min-width: 7ch;
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .recipe-brew-timer__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .recipe-wake-row {
    min-height: 3.5rem;
    justify-content: flex-start;
    border-bottom: 1px solid var(--color-line);
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }

  .recipe-wake-control {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .recipe-brew-step {
    min-height: 17rem;
    overflow-y: auto;
    padding: 1.5rem 1.25rem 2rem;
  }

  .recipe-brew-progress {
    appearance: none;
    width: 100%;
    height: 0.375rem;
    margin-top: 0.75rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: var(--color-line);
    color: var(--color-accent);
  }

  .recipe-brew-progress::-webkit-progress-bar {
    background: var(--color-line);
  }

  .recipe-brew-progress::-webkit-progress-value {
    background: var(--color-accent);
  }

  .recipe-brew-progress::-moz-progress-bar {
    background: var(--color-accent);
  }

  .recipe-brew-step__text {
    max-width: 36rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.28;
  }

  .recipe-brew-step__text:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 0.25rem;
    border-radius: var(--radius-md);
  }

  /* Numbered steps double as a checklist you can tick while brewing. */
  #recipe-body ol {
    counter-reset: step;
    padding-left: 0;
  }

  #recipe-body ol > li {
    position: relative;
    padding-left: 2.25rem;
    list-style: none;
    counter-increment: step;
  }

  .recipe-step-toggle {
    display: block;
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  #recipe-body ol > li::before {
    content: counter(step);
    position: absolute;
    top: 0.05em;
    left: 0;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    font-weight: 600;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  #recipe-body ol > li[data-done='true'] {
    opacity: 0.55;
    text-decoration: line-through;
  }

  #recipe-body ol > li[data-done='true']::before {
    content: '✓';
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-ivory);
    text-decoration: none;
  }

  @media (max-width: 39.99rem) {
    .recipe-tools__actions {
      align-items: stretch;
    }

    .recipe-cups {
      width: 100%;
      justify-content: space-between;
    }

    .recipe-brew-dialog {
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      border: 0;
      border-radius: 0;
    }

    .recipe-brew-dialog__layout {
      height: 100dvh;
      max-height: 100dvh;
    }

    .recipe-brew-timer {
      align-items: flex-end;
    }

    .recipe-brew-timer__time {
      font-size: 2rem;
    }

    .recipe-brew-timer__actions {
      max-width: 11rem;
    }

    .recipe-brew-timer__actions .recipe-tool-button {
      flex: 1 1 auto;
      min-height: 40px;
      padding: 0 0.75rem;
      font-size: 0.8125rem;
    }

    .recipe-brew-step {
      min-height: 0;
    }

    .recipe-brew-step__text {
      margin-top: 1.5rem;
      font-size: 1.5rem;
    }

    .recipe-brew-dialog__footer .recipe-tool-button {
      min-width: 0;
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-tool-button,
    .recipe-icon-button,
    .recipe-cups__button,
    #recipe-body ol > li::before {
      transition: none;
    }
  }

  @media print {
    #recipe-body ol > li::before {
      border-color: #999;
    }
  }
</style>

<script>
  import { scaleRecipeMeasurements } from '../lib/recipes';

  interface WakeLockSentinelLike {
    release: () => Promise<void>;
    addEventListener: (type: 'release', listener: () => void) => void;
  }

  type NavigatorWithWakeLock = Navigator & {
    wakeLock?: { request: (type: 'screen') => Promise<WakeLockSentinelLike> };
  };

  document.querySelectorAll<HTMLElement>('[data-recipe-experience]').forEach((experience) => {
    const recipeBody = document.getElementById('recipe-body');
    const tools = experience.querySelector<HTMLElement>('[data-recipe-tools]');
    const dialog = experience.querySelector<HTMLDialogElement>('[data-brew-dialog]');
    const stepHeading = Array.from(recipeBody?.querySelectorAll(':scope > h2') ?? []).find(
      (heading) => heading.textContent?.trim().toLowerCase() === 'steps',
    );
    const stepList = stepHeading?.nextElementSibling;

    if (
      !recipeBody ||
      !tools ||
      !dialog ||
      !(stepHeading instanceof HTMLHeadingElement) ||
      !(stepList instanceof HTMLOListElement)
    ) {
      return;
    }

    const stepItems = Array.from(stepList.children).filter(
      (item): item is HTMLLIElement => item instanceof HTMLLIElement,
    );
    if (stepItems.length === 0) return;

    stepHeading.insertAdjacentElement('afterend', tools);
    tools.hidden = false;

    const resetStepsButton = tools.querySelector<HTMLButtonElement>('[data-reset-steps]');
    const openButton = tools.querySelector<HTMLButtonElement>('[data-open-brew-mode]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-close-brew-mode]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-previous-step]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-next-step]');
    const currentStep = dialog.querySelector<HTMLElement>('[data-current-step]');
    const stepCount = dialog.querySelector<HTMLElement>('[data-step-count]');
    const stepComplete = dialog.querySelector<HTMLElement>('[data-step-complete]');
    const stepProgress = dialog.querySelector<HTMLProgressElement>('[data-step-progress]');
    const stepStatus = tools.querySelector<HTMLElement>('[data-step-status]');
    const cupStatus = tools.querySelector<HTMLElement>('[data-cup-status]');
    const cupNote = tools.querySelector<HTMLElement>('[data-cup-note]');

    let currentIndex = 0;

    const stepButtons: HTMLButtonElement[] = [];
    const stepText = (item: HTMLLIElement) =>
      stepButtons[stepItems.indexOf(item)]?.textContent?.trim() ?? item.textContent?.trim() ?? '';

    const updateStepLabel = (item: HTMLLIElement, index: number) => {
      const done = item.dataset.done === 'true';
      stepButtons[index]?.setAttribute(
        'aria-label',
        `Step ${index + 1}: ${stepText(item)} ${done ? 'Completed. Activate to mark incomplete.' : 'Activate to mark complete.'}`,
      );
    };

    const updateResetState = () => {
      if (resetStepsButton) {
        resetStepsButton.disabled = !stepItems.some((item) => item.dataset.done === 'true');
      }
    };

    const setStepDone = (item: HTMLLIElement, done: boolean) => {
      item.dataset.done = done ? 'true' : 'false';
      stepButtons[stepItems.indexOf(item)]?.setAttribute('aria-pressed', done ? 'true' : 'false');
      updateStepLabel(item, stepItems.indexOf(item));
      updateResetState();
    };

    stepItems.forEach((item, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'recipe-step-toggle';
      button.setAttribute('aria-pressed', 'false');
      while (item.firstChild) button.append(item.firstChild);
      item.append(button);
      stepButtons.push(button);
      updateStepLabel(item, index);

      const toggle = () => {
        setStepDone(item, item.dataset.done !== 'true');
        if (dialog.open && index === currentIndex) renderDialogStep();
      };

      button.addEventListener('click', toggle);
    });

    const renderDialogStep = (focus = false) => {
      const item = stepItems[currentIndex];
      if (!item || !currentStep || !stepCount || !stepProgress || !nextButton || !previousButton) {
        return;
      }

      const done = item.dataset.done === 'true';
      const isLast = currentIndex === stepItems.length - 1;
      currentStep.textContent = stepText(item);
      stepCount.textContent = `Step ${currentIndex + 1} of ${stepItems.length}`;
      stepProgress.max = stepItems.length;
      stepProgress.value = currentIndex + 1;
      stepProgress.textContent = `Step ${currentIndex + 1} of ${stepItems.length}`;
      previousButton.disabled = currentIndex === 0;
      nextButton.disabled = isLast && done;
      nextButton.textContent = isLast ? (done ? 'Brew complete' : 'Finish brew') : done ? 'Next step' : 'Mark done & next';
      if (stepComplete) stepComplete.textContent = done ? 'Completed' : '';

      if (focus) requestAnimationFrame(() => currentStep.focus());
    };

    resetStepsButton?.addEventListener('click', () => {
      stepItems.forEach((item) => setStepDone(item, false));
      currentIndex = 0;
      renderDialogStep();
      if (stepStatus) stepStatus.textContent = 'All recipe steps reset.';
    });

    previousButton?.addEventListener('click', () => {
      if (currentIndex === 0) return;
      currentIndex -= 1;
      renderDialogStep(true);
    });

    nextButton?.addEventListener('click', () => {
      const item = stepItems[currentIndex];
      if (!item) return;
      setStepDone(item, true);
      if (currentIndex < stepItems.length - 1) currentIndex += 1;
      renderDialogStep(true);
    });

    const baseCups = Number(experience.dataset.baseCups);
    const cupButtons = Array.from(tools.querySelectorAll<HTMLButtonElement>('[data-cups]'));
    if (Number.isFinite(baseCups) && baseCups > 0 && cupButtons.length > 0) {
      const scalableElements = [
        ...Array.from(document.querySelectorAll<HTMLElement>('[data-recipe-measurement]')),
        ...Array.from(document.querySelectorAll<HTMLElement>('[data-recipe-ingredients] li')),
        ...stepButtons,
      ];

      scalableElements.forEach((element) => {
        element.dataset.baseRecipeText ??= element.textContent?.trim() ?? '';
      });

      const applyCupScale = (cups: number, announce = true) => {
        const factor = cups / baseCups;
        scalableElements.forEach((element) => {
          element.textContent = scaleRecipeMeasurements(
            element.dataset.baseRecipeText ?? '',
            factor,
          );
        });
        stepItems.forEach(updateStepLabel);
        cupButtons.forEach((button) => {
          button.setAttribute('aria-pressed', Number(button.dataset.cups) === cups ? 'true' : 'false');
        });

        const isBatchScale = experience.dataset.batchScaling === 'true' && cups > 1;
        if (cupStatus) {
          cupStatus.textContent = announce
            ? isBatchScale
              ? `Quantities updated for ${cups} cups across ${cups} batches.`
              : `Quantities updated for ${cups} ${cups === 1 ? 'cup' : 'cups'}.`
            : '';
        }
        if (cupNote) {
          cupNote.textContent = experience.dataset.cupNoteText ?? '';
          cupNote.hidden = !isBatchScale || !cupNote.textContent;
        }
        renderDialogStep();
      };

      cupButtons.forEach((button) => {
        button.addEventListener('click', () => applyCupScale(Number(button.dataset.cups)));
      });
      applyCupScale(baseCups, false);
    }

    const timerDisplay = dialog.querySelector<HTMLTimeElement>('[data-brew-time]');
    const timerButton = dialog.querySelector<HTMLButtonElement>('[data-toggle-timer]');
    const resetTimerButton = dialog.querySelector<HTMLButtonElement>('[data-reset-timer]');
    let elapsedMilliseconds = 0;
    let timerStartedAt: number | undefined;
    let timerInterval: number | undefined;

    const totalElapsed = () =>
      elapsedMilliseconds + (timerStartedAt === undefined ? 0 : Date.now() - timerStartedAt);

    const renderTimer = () => {
      if (!timerDisplay) return;
      const seconds = Math.floor(totalElapsed() / 1000);
      const hours = Math.floor(seconds / 3600);
      const minutes = Math.floor((seconds % 3600) / 60);
      const remainder = seconds % 60;
      const visible = hours > 0
        ? `${hours}:${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`
        : `${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`;
      timerDisplay.textContent = visible;
      timerDisplay.dateTime = `PT${seconds}S`;
    };

    const pauseTimer = () => {
      if (timerStartedAt === undefined) return;
      elapsedMilliseconds = totalElapsed();
      timerStartedAt = undefined;
      if (timerInterval !== undefined) window.clearInterval(timerInterval);
      timerInterval = undefined;
      if (timerButton) timerButton.textContent = 'Resume timer';
      renderTimer();
    };

    timerButton?.addEventListener('click', () => {
      if (timerStartedAt !== undefined) {
        pauseTimer();
        return;
      }
      timerStartedAt = Date.now();
      timerInterval = window.setInterval(renderTimer, 250);
      timerButton.textContent = 'Pause timer';
      renderTimer();
    });

    resetTimerButton?.addEventListener('click', () => {
      if (timerInterval !== undefined) window.clearInterval(timerInterval);
      timerInterval = undefined;
      timerStartedAt = undefined;
      elapsedMilliseconds = 0;
      if (timerButton) timerButton.textContent = 'Start timer';
      renderTimer();
    });

    const wakeNavigator = navigator as NavigatorWithWakeLock;
    const wakeControl = dialog.querySelector<HTMLElement>('[data-wake-control]');
    const wakeCheckbox = dialog.querySelector<HTMLInputElement>('[data-keep-awake]');
    const wakeStatus = dialog.querySelector<HTMLElement>('[data-wake-status]');
    let wakeLock: WakeLockSentinelLike | undefined;
    let wakeRequested = false;

    if (wakeNavigator.wakeLock && wakeControl) wakeControl.hidden = false;

    const releaseWakeLock = async () => {
      const current = wakeLock;
      wakeLock = undefined;
      if (current) await current.release();
    };

    const requestWakeLock = async () => {
      if (
        !wakeRequested ||
        !dialog.open ||
        document.visibilityState !== 'visible' ||
        !wakeNavigator.wakeLock ||
        wakeLock
      ) {
        return;
      }
      try {
        wakeLock = await wakeNavigator.wakeLock.request('screen');
        wakeLock.addEventListener('release', () => {
          wakeLock = undefined;
        });
        if (wakeStatus) wakeStatus.textContent = 'Screen will stay awake while brew mode is open.';
      } catch {
        wakeRequested = false;
        if (wakeCheckbox) wakeCheckbox.checked = false;
        if (wakeStatus) wakeStatus.textContent = 'Screen wake is unavailable on this device.';
      }
    };

    wakeCheckbox?.addEventListener('change', async () => {
      wakeRequested = wakeCheckbox.checked;
      if (wakeRequested) await requestWakeLock();
      else {
        await releaseWakeLock();
        if (wakeStatus) wakeStatus.textContent = 'Screen wake turned off.';
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && wakeRequested) void requestWakeLock();
    });

    openButton?.addEventListener('click', () => {
      const firstIncomplete = stepItems.findIndex((item) => item.dataset.done !== 'true');
      currentIndex = firstIncomplete === -1 ? stepItems.length - 1 : firstIncomplete;
      dialog.showModal();
      renderDialogStep(true);
    });

    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      pauseTimer();
      wakeRequested = false;
      if (wakeCheckbox) wakeCheckbox.checked = false;
      if (wakeStatus) wakeStatus.textContent = '';
      void releaseWakeLock();
    });
  });
</script>
