---
import { photo } from '../lib/photos';
import type { CollectionEntry } from 'astro:content';
import JsonLd from './JsonLd.astro';
import {
  categoryLabel,
  extractSteps,
  isoDuration,
  recipeKeywords,
  recipeStepName,
} from '../lib/recipes';
import { equipmentFor } from '../lib/equipment';
import { formatIngredients } from '../lib/recipe-scaling';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { data } = recipe;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/recipes/${recipe.id}/`;
const steps = extractSteps(recipe.body ?? '');
const keywords = [
  ...data.seoKeywords,
  ...recipeKeywords(data).split(', '),
].filter((keyword, index, all) => all.indexOf(keyword) === index);
const recipeIngredients = formatIngredients(
  data.ingredients,
  { servings: 1, units: 'metric', ...(data.espresso ? { dose: data.espresso.dose } : {}) },
  data.espresso,
);

// Ratings, videos and step media belong here only when the page shows real source data.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': url,
  url,
  name: data.title,
  description: data.description,
  image: `${site}${photo(data.image).src}`,
  author: { '@type': 'Organization', name: data.author },
  publisher: { '@type': 'Organization', name: 'KAVOVO' },
  datePublished: data.datePublished.toISOString().slice(0, 10),
  dateModified: data.dateModified.toISOString().slice(0, 10),
  prepTime: isoDuration(data.prepTime),
  ...(data.brewTime > 0 ? { cookTime: isoDuration(data.brewTime) } : {}),
  totalTime: isoDuration(data.totalTime),
  recipeYield:
    data.schemaYield ??
    (data.drinkYield === data.yield ? data.yield : `${data.yield} (${data.drinkYield})`),
  recipeCategory: categoryLabel(data.category),
  recipeCuisine: data.recipeCuisine,
  keywords: keywords.join(', '),
  recipeIngredient: recipeIngredients,
  tool: [
    ...equipmentFor(data.equipmentSet),
    ...data.equipmentExtra,
    ...data.equipmentOptional,
  ].map((name) => ({
    '@type': 'HowToTool',
    name,
  })),
  ...(steps.length
    ? {
        recipeInstructions: steps.map((text, index) => ({
          '@type': 'HowToStep',
          position: index + 1,
          name: recipeStepName(text),
          text,
          url: `${url}#step-${index + 1}`,
        })),
      }
    : {}),
};
---

<JsonLd schema={schema} />
