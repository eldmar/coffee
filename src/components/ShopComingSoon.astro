---
import Photo from './Photo.astro';
---

<section class="bg-ivory">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:grid-cols-2 md:py-0">
    <div class="py-2 md:py-16">
      <span class="eyebrow">Coming soon</span>
      <h2 class="mt-3 font-display text-4xl leading-tight font-medium text-balance">
        Coffee chosen for the way you brew.
      </h2>
      <p class="mt-4 max-w-sm text-ink-soft">
        Small-batch coffees selected to perform in your favourite brew methods. We'll be ready when you are.
      </p>
      <a
        href="/shop/"
        class="mt-7 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
      >
        Join the waitlist
      </a>
    </div>
    <div class="-mx-5 md:mx-0 md:self-stretch">
      <Photo
        name="shop-teaser"
        alt="KAVOVO Ethiopia coffee bag on a wooden board beside a ceramic cup"
        sizes="(min-width: 768px) 50vw, 100vw"
        class="h-64 w-full object-cover md:h-full md:min-h-[380px]"
        loading="lazy"
      />
    </div>
  </div>
</section>
