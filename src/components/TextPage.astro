---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  updated?: string;
}

const { eyebrow, title, intro, updated } = Astro.props;
---

<article class="mx-auto max-w-2xl px-5 py-14">
  <span class="eyebrow">{eyebrow}</span>
  <h1 class="mt-3 font-display text-4xl leading-tight font-medium text-balance">{title}</h1>
  {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
  {
    updated && (
      <p class="mt-4 text-sm text-ink-soft">
        Last updated <time datetime={updated}>{updated}</time>
      </p>
    )
  }
  <div
    class="mt-8 border-t border-line pt-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:mt-10 [&_h2]:mb-2 [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-ink-soft [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_li]:text-ink-soft [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_strong]:text-ink"
  >
    <slot />
  </div>
</article>
