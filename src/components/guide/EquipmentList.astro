---
interface Props {
  essential: { name: string; note: string }[];
  optional: { name: string; note: string }[];
}

const { essential, optional } = Astro.props;

const groups = [
  { title: 'Essential', items: essential, hint: 'You cannot brew the method properly without these.' },
  { title: 'Useful but optional', items: optional, hint: 'These make it easier, not possible.' },
];
---

<section id="equipment" class="guide-section">
  <h2 class="font-display text-2xl font-medium">Equipment</h2>
  <div class="mt-4 grid gap-6 sm:grid-cols-2">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-medium">{group.title}</h3>
          <p class="mt-1 text-sm text-ink-soft">{group.hint}</p>
          <ul class="mt-3 flex flex-col">
            {group.items.map((item) => (
              <li class="border-b border-line py-3 last:border-b-0">
                <span class="block text-sm font-medium">{item.name}</span>
                <span class="mt-0.5 block text-sm text-ink-soft">{item.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
