---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

{/*
  One list serves both layouts. It ships open, so the links are there without
  JavaScript; a small script collapses it on narrow screens, where a disclosure
  is the point. <summary> carries aria-expanded natively.
*/}
<details id="guide-toc" class="guide-toc rounded-lg border border-line bg-card" open>
  <summary
    class="flex min-h-11 cursor-pointer items-center justify-between px-5 text-sm font-medium lg:hidden"
  >
    On this page
    <svg
      class="guide-toc__chevron shrink-0 transition-transform"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <nav aria-label="On this page" class="px-5 pb-5 lg:pt-5">
    <p class="hidden text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase lg:block">
      On this page
    </p>
    <ul class="mt-3 flex flex-col gap-1 text-sm lg:mt-3">
      {
        sections.map((section) => (
          <li>
            <a
              href={`#${section.id}`}
              class="block py-1.5 text-ink-soft hover:text-accent hover:underline"
            >
              {section.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>

<script>
  /**
   * The list is open in the markup so it works without JavaScript. Below the
   * desktop breakpoint it becomes a disclosure, closed until someone opens it.
   */
  const toc = document.getElementById('guide-toc');
  if (toc instanceof HTMLDetailsElement) {
    const wide = window.matchMedia('(min-width: 64rem)');
    const sync = () => {
      toc.open = wide.matches;
    };
    sync();
    wide.addEventListener('change', sync);

    // Jumping to a section should close the disclosure behind you.
    toc.addEventListener('click', (event) => {
      if (!wide.matches && (event.target as HTMLElement).closest('a')) toc.open = false;
    });
  }
</script>
