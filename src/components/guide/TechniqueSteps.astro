---
interface Props {
  steps: { action: string; why: string }[];
  keyPoint: string;
}

const { steps, keyPoint } = Astro.props;
---

<section id="technique" class="guide-section">
  <h2 class="font-display text-2xl font-medium">Step-by-step technique</h2>

  <p class="mt-4 rounded-lg border border-line border-l-[3px] border-l-sage bg-card px-5 py-4">
    <span class="block text-[0.6875rem] font-semibold tracking-[0.14em] text-sage uppercase">
      The one thing that matters most
    </span>
    <span class="mt-1.5 block text-ink-soft">{keyPoint}</span>
  </p>

  {/*
    A plain ordered list. Ticking steps off belongs to the recipe pages, where
    someone is brewing rather than reading.
  */}
  <ol class="mt-6 flex list-decimal flex-col gap-5 pl-5 marker:font-medium marker:text-accent">
    {
      steps.map((step) => (
        <li class="pl-1">
          <span class="block font-medium">{step.action}</span>
          <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{step.why}</span>
        </li>
      ))
    }
  </ol>
</section>
