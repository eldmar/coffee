---
interface Props {
  items: { problem: string; cause: string; first: string; next: string }[];
}

const { items } = Astro.props;
---

<section id="troubleshooting" class="guide-section">
  <h2 class="font-display text-2xl font-medium">Troubleshooting</h2>
  <p class="mt-4 text-ink-soft">Open the symptom that matches your cup.</p>

  {/*
    Native <details> rather than a scripted accordion: keyboard operable and
    announced with its expanded state without any JavaScript of ours.
  */}
  <ul class="mt-5 flex flex-col gap-3">
    {
      items.map((item) => (
        <li>
          <details class="guide-detail rounded-lg border border-line bg-card">
            <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 px-5 py-3 font-medium">
              {item.problem}
              <svg
                class="guide-detail__chevron shrink-0 text-ink-soft transition-transform"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <dl class="border-t border-line px-5 py-4 text-sm">
              <dt class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">
                Likely cause
              </dt>
              <dd class="mt-1 text-ink-soft">{item.cause}</dd>
              <dt class="mt-4 text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">
                Change first
              </dt>
              <dd class="mt-1 text-ink-soft">{item.first}</dd>
              <dt class="mt-4 text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">
                Check next
              </dt>
              <dd class="mt-1 text-ink-soft">{item.next}</dd>
            </dl>
          </details>
        </li>
      ))
    }
  </ul>
</section>
