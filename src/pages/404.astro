---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';

const recipes = await getCollection('recipes');
const popular = recipes.filter((r) => r.data.popular).slice(0, 3);
---

<Layout
  title="Page not found — KAVOVO"
  description="That page does not exist. Search KAVOVO or start from a popular recipe."
  noindex
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="mx-auto max-w-xl text-center">
      <img
        src="/images/kavovo-lockup.svg"
        alt="KAVOVO"
        width="1191"
        height="156"
        class="mx-auto h-6 w-auto"
      />

      <span class="eyebrow mt-8 block">404</span>
      <h1 class="mt-3 font-display text-4xl leading-tight font-medium text-balance">
        This page didn't brew.
      </h1>
      <p class="mt-4 text-ink-soft">
        The page you're looking for may have moved or no longer exists.
      </p>

      <form action="/search/" method="get" role="search" class="mx-auto mt-8 flex max-w-sm gap-2">
        <label class="sr-only" for="notfound-search">
          Search recipes, guides, learning paths and journal articles
        </label>
        <input
          id="notfound-search"
          type="search"
          name="q"
          placeholder="Search KAVOVO"
          aria-label="Search recipes, guides, learning paths and journal articles"
          class="flex-1 rounded-md border border-line bg-card px-4 py-2.5 text-sm outline-none focus:border-accent"
        />
        <button
          type="submit"
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
        >
          Search
        </button>
      </form>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/recipes/"
          class="rounded-md border border-ink/25 px-5 py-2.5 text-sm font-medium transition-colors hover:border-ink/50"
        >
          Browse recipes
        </a>
        <a href="/" class="text-sm font-medium text-accent hover:underline">Return home</a>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-medium">Popular recipes</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          popular.map((recipe) => (
            <RecipeCard
              slug={recipe.id}
              title={recipe.data.title}
              image={recipe.data.image}
              category={recipe.data.category}
              activeTime={recipe.data.activeTime}
              totalTime={recipe.data.totalTime}
              totalTimeLabel={recipe.data.totalTimeLabel}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
