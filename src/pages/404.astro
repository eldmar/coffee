---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';

const recipes = await getCollection('recipes');
const popular = recipes.filter((r) => r.data.popular).slice(0, 3);
---

<Layout
  title="Page not found — KAVOVO"
  description="That page does not exist. Search the recipes or start from a popular one."
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="mx-auto max-w-xl text-center">
      <span class="eyebrow">404</span>
      <h1 class="mt-3 font-display text-4xl leading-tight font-medium text-balance">
        That page has gone cold.
      </h1>
      <p class="mt-4 text-ink-soft">
        The address you followed doesn't exist — it may have moved, or the link may have a typo. Try a search, or start
        from one of the recipes below.
      </p>

      <form action="/recipes/" method="get" role="search" class="mx-auto mt-8 flex max-w-sm gap-2">
        <label class="sr-only" for="notfound-search">Search recipes</label>
        <input
          id="notfound-search"
          type="search"
          name="q"
          placeholder="Search recipes"
          class="flex-1 rounded-md border border-line bg-card px-4 py-2.5 text-sm outline-none focus:border-accent"
        />
        <button
          type="submit"
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
        >
          Search
        </button>
      </form>

      <p class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
        <a href="/recipes/" class="font-medium text-accent hover:underline">All recipes</a>
        <a href="/guides/" class="font-medium text-accent hover:underline">Brew guides</a>
        <a href="/learn/" class="font-medium text-accent hover:underline">Learn</a>
        <a href="/journal/" class="font-medium text-accent hover:underline">Journal</a>
      </p>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-medium">Popular recipes</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {popular.map((recipe) => (
          <RecipeCard
            slug={recipe.id}
            title={recipe.data.title}
            image={recipe.data.image}
            category={recipe.data.category}
            activeTime={recipe.data.activeTime}
          totalTime={recipe.data.totalTime}
          totalTimeLabel={recipe.data.totalTimeLabel}
            difficulty={recipe.data.difficulty}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
