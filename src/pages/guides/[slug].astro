---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import Photo from '../../components/Photo.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { photo } from '../../lib/photos';
import { readingMinutes } from '../../lib/learn';
import GuideSection from '../../components/guide/GuideSection.astro';
import QuickStart from '../../components/guide/QuickStart.astro';
import TableOfContents from '../../components/guide/TableOfContents.astro';
import EquipmentList from '../../components/guide/EquipmentList.astro';
import TechniqueSteps from '../../components/guide/TechniqueSteps.astro';
import VariableCards from '../../components/guide/VariableCards.astro';
import TasteTable from '../../components/guide/TasteTable.astro';
import TroubleshootingList from '../../components/guide/TroubleshootingList.astro';
import RelatedLearning from '../../components/guide/RelatedLearning.astro';

export async function getStaticPaths() {
  const [guides, recipes] = await Promise.all([
    getCollection('guides'),
    getCollection('recipes'),
  ]);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide,
      canonical: recipes.find((r) => r.id === guide.data.canonicalRecipe),
      related: recipes.filter((r) => r.data.brewMethod === guide.data.method),
    },
  }));
}

const { guide, canonical, related } = Astro.props;
const { data } = guide;

if (!canonical) {
  throw new Error(
    `Guide "${guide.id}" names canonicalRecipe "${data.canonicalRecipe}", which does not exist.`,
  );
}

// Section ids live in one list so the contents and the headings cannot drift.
const sections = [
  { id: 'quick-start', label: 'Quick start' },
  { id: 'equipment', label: 'Equipment' },
  { id: 'how-it-works', label: 'How it works' },
  { id: 'technique', label: 'Technique' },
  { id: 'variables', label: 'Variables that matter' },
  { id: 'adjust', label: 'Adjust by taste' },
  { id: 'choosing-coffee', label: 'Choosing coffee' },
  ...(data.milk ? [{ id: 'milk', label: 'Milk' }] : []),
  { id: 'troubleshooting', label: 'Troubleshooting' },
  { id: 'cleaning', label: 'Cleaning and care' },
];

// The hero uses the canonical recipe's photograph: it is the same method, and
// it keeps the guide from needing a duplicate asset.
const heroImage = canonical.data.image;
const heroAlt = canonical.data.imageAlt ?? `${data.title} coffee being brewed`;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/guides/${guide.id}/`;
const ogImagePath = photo(heroImage).src;

// Article, not Recipe: the Recipe schema belongs to the recipe page.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': url,
  url,
  headline: `${data.title} brew guide`,
  description: data.description,
  image: `${site}${ogImagePath}`,
  timeRequired: `PT${data.readingTime}M`,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'KAVOVO', url: `${site}/about/` },
  publisher: { '@type': 'Organization', name: 'KAVOVO' },
  mainEntityOfPage: url,
};
---

<Layout
  title={`${data.title} Brew Guide — KAVOVO`}
  description={data.description}
  ogImage={ogImagePath}
  ogType="article"
>
  <div class="mx-auto max-w-[1152px] px-5 py-12">
    <JsonLd schema={schema} />
    <Breadcrumbs trail={[{ label: 'Brew Guides', href: '/guides/' }, { label: data.title }]} />

    <header class="mt-6">
      <span class="eyebrow block">Brew guide</span>
      <h1 class="mt-2 font-display text-4xl font-medium text-balance">{data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">{data.description}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <p class="text-ink-soft">{readingMinutes(data.readingTime)} read</p>
        <a href="#quick-start" class="font-medium text-accent hover:underline">
          Jump to quick start
        </a>
      </div>
      <Photo
        name={heroImage}
        alt={heroAlt}
        sizes="(min-width: 1152px) 1112px, 100vw"
        class="mt-8 aspect-[4/3] w-full rounded-lg object-cover sm:aspect-[21/9]"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    {
      data.notice && (
        <p class="mt-8 rounded-md border border-accent/40 bg-accent/5 px-4 py-3 text-sm font-medium">
          {data.notice}
        </p>
      )
    }

    <section class="mt-10 max-w-[760px]">
      {data.intro.map((text) => <p class="mt-4 text-lg leading-relaxed text-ink-soft first:mt-0">{text}</p>)}
    </section>

    {/*
      One contents list, placed by grid order: after the introduction on narrow
      screens, in a sticky right-hand column from the large breakpoint. Rendering
      it twice would duplicate every id.
    */}
    <div class="mt-8 gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start">
      <div class="lg:sticky lg:top-24 lg:order-2">
        <TableOfContents sections={sections} />
      </div>

      <div class="min-w-0 lg:order-1 lg:max-w-[760px]">
        <QuickStart guide={data} recipe={canonical} />
        <EquipmentList essential={data.equipmentEssential} optional={data.equipmentOptional} />
        <GuideSection id="how-it-works" title="How it works" paragraphs={data.howItWorks} />
        <TechniqueSteps steps={data.technique} keyPoint={data.keyPoint} />
        <VariableCards variables={data.variables} />
        <TasteTable method={data.title} adjustments={data.tasteAdjustments} />
        <GuideSection id="choosing-coffee" title="Choosing coffee" paragraphs={data.choosingCoffee} />
        {data.milk && <GuideSection id="milk" title="Milk" paragraphs={data.milk} />}
        <TroubleshootingList items={data.troubleshooting} />
        <GuideSection id="cleaning" title="Cleaning and care" paragraphs={data.cleaning} />
        <RelatedLearning lessons={data.relatedLearning} />

        {
          related.length > 0 && (
            <section class="guide-section">
              <h2 class="font-display text-2xl font-medium">Recipes with this method</h2>
              <p class="mt-4 text-ink-soft">
                Put the method into practice with one of these tested KAVOVO recipes.
              </p>
              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                {related.map((recipe) => (
                  <RecipeCard
                    slug={recipe.id}
                    title={recipe.data.title}
                    image={recipe.data.image}
                    category={recipe.data.category}
                    activeTime={recipe.data.activeTime}
                    totalTime={recipe.data.totalTime}
                    totalTimeLabel={recipe.data.totalTimeLabel}
                  />
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Layout>
