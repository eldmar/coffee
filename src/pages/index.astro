---
import { getCollection } from 'astro:content';
import { thumbImage } from '../lib/cardImage';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import RecipeFinder from '../components/RecipeFinder';
import RecipeCard from '../components/RecipeCard.astro';
import BrewMethods from '../components/BrewMethods.astro';
import LearningPaths from '../components/LearningPaths.astro';
import Troubleshooting from '../components/Troubleshooting.astro';
import Newsletter from '../components/Newsletter.astro';
import ShopComingSoon from '../components/ShopComingSoon.astro';
import JsonLd from '../components/JsonLd.astro';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'KAVOVO',
  url: `${site}/`,
  logo: `${site}/images/kavovo-lockup.svg`,
  description:
    'Straightforward coffee drink recipes and practical brewing guides for people making coffee at home.',
  email: 'hello@kavovo.coffee',
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  name: 'KAVOVO',
  url: `${site}/`,
  publisher: { '@id': `${site}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${site}/search/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const recipes = await getCollection('recipes');
const popular = recipes.filter((r) => r.data.popular).slice(0, 3);

const finderRecipes = recipes.map((r) => ({
  slug: r.id,
  title: r.data.title,
  image: thumbImage(r.data.image),
  category: r.data.category,
  brewMethod: r.data.brewMethod,
  temperature: r.data.temperature,
  milk: r.data.milk,
  activeTime: r.data.activeTime,
  totalTime: r.data.totalTime,
  totalTimeLabel: r.data.totalTimeLabel,
    difficulty: r.data.difficulty,
}));
---

<Layout>
  <JsonLd schema={organisation} />
  <JsonLd schema={website} />
  <Hero />

  <section class="mx-auto max-w-6xl px-5">
    <div class="relative z-10 -mt-2 md:-mt-28">
      <RecipeFinder client:visible recipes={finderRecipes} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-3xl font-medium">Popular recipes</h2>
      <a href="/recipes/" class="text-sm font-medium text-accent hover:underline">View all recipes &#8594;</a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((recipe) => (
        <RecipeCard
          slug={recipe.id}
          title={recipe.data.title}
          image={recipe.data.image}
          category={recipe.data.category}
          activeTime={recipe.data.activeTime}
          totalTime={recipe.data.totalTime}
          totalTimeLabel={recipe.data.totalTimeLabel}
          difficulty={recipe.data.difficulty}
        />
      ))}
    </div>
  </section>

  <BrewMethods />
  <LearningPaths />
  <Troubleshooting />
  <div id="newsletter">
    <Newsletter />
  </div>
  <ShopComingSoon />
</Layout>
