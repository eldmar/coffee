---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Journal — Kavovo" description="Stories, ideas, and field notes on home coffee culture.">
  <section class="mx-auto max-w-3xl px-5 py-14">
    <span class="eyebrow">Journal</span>
    <h1 class="mt-3 font-display text-4xl font-medium">Stories worth a slow cup</h1>
    <p class="mt-3 max-w-lg text-ink-soft">
      Ideas, habits, and field notes on brewing better coffee at home.
    </p>
    <div class="mt-10 flex flex-col gap-6">
      {posts.map((post) => (
        <a
          href={`/journal/${post.id}`}
          class="group rounded-lg border border-line bg-card p-6 transition-shadow hover:shadow-md"
        >
          <time datetime={post.data.date.toISOString()} class="text-sm text-ink-soft">
            {formatDate(post.data.date)}
          </time>
          <h2 class="mt-2 font-display text-2xl font-medium text-balance">{post.data.title}</h2>
          <p class="mt-2 text-sm text-ink-soft">{post.data.description}</p>
          <span class="mt-4 inline-block text-sm font-medium text-clay">
            Read the story
            <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">&#8594;</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
