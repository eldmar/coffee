---
import Layout from '../layouts/Layout.astro';

const paths = [
  {
    id: 'basics',
    title: 'Coffee basics',
    description:
      'Essential knowledge and simple recipes: what gear you actually need, how grind size works, and your first great cups.',
  },
  {
    id: 'espresso',
    title: 'Dial in espresso',
    description:
      'From your first shot to consistent, repeatable espresso: dose, yield, time, and how to taste the difference.',
  },
  {
    id: 'beans',
    title: 'Understand your beans',
    description:
      'Origin, processing, roast level, and flavor — how to read a bag of coffee and pick beans you will love.',
  },
];
---

<Layout title="Learn — KAVOVO" description="Guided learning paths from your first cup to confident brewing.">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <span class="eyebrow">Learn</span>
    <h1 class="mt-3 font-display text-4xl font-medium">From beans to brew</h1>
    <p class="mt-3 max-w-lg text-ink-soft">
      A clear beginner path that walks you through everything — from choosing your beans to brewing a cup you'll love.
      Full lessons are being written now; here's what each path covers.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {paths.map((path, index) => (
        <section id={path.id} class="rounded-lg border border-line bg-card p-6">
          <span class="eyebrow">Path {index + 1}</span>
          <h2 class="mt-2 font-display text-2xl font-medium">{path.title}</h2>
          <p class="mt-3 text-sm text-ink-soft">{path.description}</p>
        </section>
      ))}
    </div>
  </section>
</Layout>
