---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Photo from '../../../components/Photo.astro';
import JsonLd from '../../../components/JsonLd.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import CoffeeRatioCalculator from '../../../components/CoffeeRatioCalculator.astro';
import EspressoRatioCalculator from '../../../components/EspressoRatioCalculator.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { photo } from '../../../lib/photos';
import { pathBySlug, readingMinutes } from '../../../lib/learn';
import { extractFaqs } from '../../../lib/recipes';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => {
    const siblings = lessons
      .filter((l) => l.data.path === lesson.data.path)
      .sort((a, b) => a.data.order - b.data.order);
    const position = siblings.findIndex((l) => l.id === lesson.id);
    // The lesson id already carries its folder, e.g. "coffee-basics/grind-size".
    const [pathSlug, lessonSlug] = lesson.id.split('/');
    return {
      params: { path: pathSlug, lesson: lessonSlug },
      props: {
        lesson,
        total: siblings.length,
        previous: siblings[position - 1],
        next: siblings[position + 1],
      },
    };
  });
}

const { lesson, total, previous, next } = Astro.props;
const { Content, headings } = await render(lesson);
const { data } = lesson;
const isRatioLesson = lesson.id === 'coffee-basics/coffee-to-water-ratio';
const isEspressoRatioLesson = lesson.id === 'dial-in-espresso/espresso-ratio';
const isComparisonGuide = data.contentType === 'Comparison guide';
const faqs = extractFaqs(lesson.body ?? '');

// Contents lists the real sections only. The three callouts are h2 for document
// structure, but they are not places a reader jumps to.
const CALLOUT_SLUGS = [
  'the-short-answer',
  'arabica-vs-robusta-the-short-answer',
  'try-this-today',
  'key-takeaway',
];
const contents = headings.filter((h) => h.depth === 2 && !CALLOUT_SLUGS.includes(h.slug));

const path = pathBySlug(data.path);
const pathTitle = path?.title ?? data.path;
const pathHome = `/learn/${data.path}/`;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/learn/${lesson.id}/`;
// Lessons without their own photo fall back to the site hero for social cards.
const heroImagePath = photo(data.image ?? 'hero').src;
const ogImagePath = data.ogImage ?? heroImagePath;
const dateFmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'LearningResource'],
  '@id': url,
  url,
  name: data.title,
  headline: data.title,
  image: `${site}${heroImagePath}`,
  description: data.seoDescription,
  learningResourceType: data.contentType,
  educationalLevel: 'Beginner',
  timeRequired: `PT${data.readingTime}M`,
  inLanguage: 'en-GB',
  isPartOf: { '@type': 'Course', name: pathTitle, url: `${site}${pathHome}` },
  position: data.order,
  author: { '@type': 'Organization', name: data.author, url: `${site}/about/` },
  publisher: {
    '@type': 'Organization',
    name: 'KAVOVO',
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/images/kavovo-lockup.svg` },
  },
  mainEntityOfPage: url,
  ...(data.datePublished
    ? { datePublished: data.datePublished.toISOString().slice(0, 10) }
    : {}),
  ...(data.dateModified
    ? { dateModified: data.dateModified.toISOString().slice(0, 10) }
    : {}),
};
---

<Layout
  title={data.seoTitle ?? `${data.title} — KAVOVO`}
  description={data.seoDescription}
  ogImage={ogImagePath}
  ogType="article"
  publishedTime={data.datePublished}
  modifiedTime={data.dateModified}
>
  <article
    class="mx-auto max-w-3xl px-5 py-12"
    data-comparison-guide={isComparisonGuide ? '' : undefined}
  >
    <JsonLd schema={schema} />
    <Breadcrumbs
      trail={[
        { label: 'Learn', href: '/learn/' },
        { label: pathTitle, href: pathHome },
        { label: data.title },
      ]}
    />

    <span class="eyebrow mt-6 block">
      <a href={pathHome} class="hover:underline">{pathTitle}</a>&#32;&#183; {data.contentType}
    </span>
    <div
      class="mt-2 h-1 w-full max-w-xs overflow-hidden rounded-full bg-line print:hidden"
      role="progressbar"
      aria-valuenow={data.order}
      aria-valuemin="1"
      aria-valuemax={total}
      aria-label={`Item ${data.order} of ${total} in ${pathTitle}`}
    >
      <span class="block h-full rounded-full bg-accent" style={`width: ${(data.order / total) * 100}%`}></span>
    </div>
    <h1 class="mt-2 font-display text-4xl font-medium text-balance">{data.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{data.excerpt}</p>
    <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm text-ink-soft">
      <span>By {data.author}</span>
      {
        (data.dateModified ?? data.datePublished) && (
          <>
            <span aria-hidden="true">&#183;</span>
            <span>
              Updated{' '}
              <time datetime={(data.dateModified ?? data.datePublished)?.toISOString()}>
                {dateFmt((data.dateModified ?? data.datePublished) as Date)}
              </time>
            </span>
          </>
        )
      }
      <span aria-hidden="true">&#183;</span>
      <span>{readingMinutes(data.readingTime)} read</span>
    </p>

    {/* Native 4:3, uncropped. These photos teach: a 16:9 crop cut the
        thermometer reading off the temperature lesson. */}
    {
      data.image && (
        <Photo
          name={data.image}
          alt={data.imageAlt ?? ''}
          sizes="(min-width: 768px) 768px, 100vw"
          class="mt-8 aspect-[4/3] w-full rounded-lg object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    {
      contents.length > 2 && (
        <nav class="mt-10 rounded-lg border border-line bg-card p-5 print:hidden" aria-labelledby="contents-heading">
          <h2 id="contents-heading" class="eyebrow">
            {isComparisonGuide ? 'In this article' : 'In this lesson'}
          </h2>
          <ol class="mt-3 flex flex-col gap-1.5 text-sm">
            {contents.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} class="text-ink-soft hover:text-accent hover:underline">
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {isRatioLesson && <CoffeeRatioCalculator />}
    {isEspressoRatioLesson && <EspressoRatioCalculator />}

    <div class:list={['prose-body mt-10', isComparisonGuide && 'prose-comparison']}>
      <Content />
    </div>

    <FaqSchema items={faqs} />

    {
      data.related.length > 0 && (
        <aside class="mt-12 rounded-lg border border-line bg-card p-5">
          <h2 class="font-display text-xl font-medium">Put it into practice</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {data.related.map((link) => (
              <li>
                <a href={link.href} class="font-medium text-accent hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <nav class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2" aria-label="Lesson">
      {
        previous ? (
          <a href={`/learn/${previous.id}/`} class="rounded-lg border border-line bg-card p-4 transition-shadow hover:shadow-md">
            <span class="eyebrow">Previous lesson</span>
            <span class="mt-1.5 block font-medium">{previous.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/learn/${next.id}/`} class="rounded-lg border border-line bg-card p-4 text-right transition-shadow hover:shadow-md sm:col-start-2">
            <span class="eyebrow">Next lesson</span>
            <span class="mt-1.5 block font-medium">{next.data.title}</span>
          </a>
        ) : (
          <div class="rounded-lg border border-line bg-card p-4 sm:col-start-2">
            <span class="eyebrow">Path complete</span>
            <p class="mt-1.5 text-sm text-ink-soft">
              {pathTitle} complete — explore the&#32;
              <a href="/learn/" class="font-medium text-accent hover:underline">
                other learning paths
              </a>
              &#32;or browse the&#32;
              <a href="/guides/" class="font-medium text-accent hover:underline">brew guides</a>.
            </p>
          </div>
        )
      }
    </nav>
  </article>

  {isComparisonGuide && <Newsletter />}

  {
    next && (
      <a href={`/learn/${next.id}/`} id="jump-next" class="jump-next print:hidden" hidden>
        <span class="jump-next__text">
          <span class="jump-next__label">Next lesson</span>
          <span class="jump-next__title">{next.data.title}</span>
        </span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    )
  }
</Layout>

<script>
  /**
   * Copy each table's column headings onto its cells. CSS uses them to turn
   * rows into cards on narrow screens, where a wide table is unreadable.
   */
  for (const table of document.querySelectorAll<HTMLTableElement>('.prose-body table')) {
    if (table.closest('.prose-comparison')) {
      table.tabIndex = 0;
      table.setAttribute('aria-label', 'Scrollable comparison table');
      const hint = document.createElement('p');
      hint.className = 'table-scroll-hint';
      hint.setAttribute('aria-hidden', 'true');
      hint.textContent = 'Swipe to compare →';
      table.before(hint);
      continue;
    }
    const labels = [...table.querySelectorAll('thead th')].map((th) => th.textContent.trim());
    if (labels.length === 0) continue;
    for (const row of table.querySelectorAll('tbody tr')) {
      [...row.children].forEach((cell, i) => {
        if (labels[i]) cell.setAttribute('data-label', labels[i]);
      });
    }
  }

  /**
   * Show the compact next-lesson button once the reader is into the article,
   * and retire it when the full next-lesson card is on screen — two identical
   * calls to action side by side help nobody.
   *
   * Computed from positions on scroll rather than IntersectionObserver: the
   * state depends on two elements at once, which is awkward to keep in sync
   * across separate observer callbacks.
   */
  const jump = document.getElementById('jump-next');
  const heading = document.querySelector('article h1');
  const footerNav = document.querySelector('nav[aria-label="Lesson"]');

  if (jump && heading && footerNav) {
    let queued = false;

    const update = () => {
      queued = false;
      const pastIntro = heading.getBoundingClientRect().bottom < 0;
      const footer = footerNav.getBoundingClientRect();
      const footerVisible = footer.top < window.innerHeight && footer.bottom > 0;
      jump.hidden = !pastIntro || footerVisible;
    };

    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>
