---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LEARN_PATHS, readingMinutes } from '../../lib/learn';
import PathCardProgress from '../../components/retention/PathCardProgress';

const lessons = await getCollection('lessons');

/** Lesson count and total reading time come from the content, never a hand-typed number. */
const stats = Object.fromEntries(
  LEARN_PATHS.map((path) => {
    const own = lessons.filter((l) => l.data.path === path.slug);
    return [
      path.slug,
      {
        count: own.length,
        minutes: own.reduce((sum, l) => sum + l.data.readingTime, 0),
        lessons: own
          .sort((a, b) => a.data.order - b.data.order)
          .map((lesson) => ({
            slug: lesson.id.split('/').at(-1),
            title: lesson.data.title,
            href: `/learn/${lesson.id}/`,
          })),
      },
    ];
  }),
);
---

<Layout
  title="Learn How to Make Better Coffee at Home | KAVOVO"
  description="Guided learning paths from your first cup to confident brewing."
  ogImage="/social/learn.webp"
>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <Breadcrumbs trail={[{ label: 'Learn' }]} />
    <span class="eyebrow mt-6 block">Learn</span>
    <h1 class="mt-2 font-display text-4xl font-medium">From beans to brew</h1>
    <p class="mt-3 max-w-lg text-ink-soft">
      A clear beginner path that walks you through everything — from choosing your beans to brewing a cup you'll love.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        LEARN_PATHS.map((path, index) => {
          const { count, minutes, lessons: pathLessons } = stats[path.slug];
          const live = path.status === 'published';
          return (
            <section
              id={path.id}
              class="flex scroll-mt-24 flex-col rounded-lg border border-line bg-card p-6"
            >
              <span class="eyebrow">Path {index + 1}</span>
              <h2 class="mt-2 font-display text-2xl font-medium">
                {live ? (
                  <a href={`/learn/${path.slug}/`} class="hover:underline">
                    {path.title}
                  </a>
                ) : (
                  path.title
                )}
              </h2>
              <p class="mt-3 flex-1 text-sm text-ink-soft">{path.description}</p>
              {live ? (
                <PathCardProgress
                  client:load
                  pathSlug={path.slug}
                  lessons={pathLessons}
                  readingTime={readingMinutes(minutes)}
                />
              ) : (
                <p class="mt-4 text-sm text-ink-soft">Lessons in progress.</p>
              )}
            </section>
          );
        })
      }
    </div>
  </section>
</Layout>
