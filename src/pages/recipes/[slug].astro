---
import { getCollection, render } from 'astro:content';
import Photo from '../../components/Photo.astro';
import { photo } from '../../lib/photos';
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import RecipeSchema from '../../components/RecipeSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  categoryLabel,
  categoryPath,
  extractSteps,
  humanDuration,
  recipeFacts,
  shareText,
} from '../../lib/recipes';
import { equipmentFor } from '../../lib/equipment';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe, all: recipes },
  }));
}

const { recipe, all } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;

const facts = recipeFacts(data);
const equipment = equipmentFor(data.equipmentSet);

const guides = await getCollection('guides');
const guide = guides.find((g) => g.data.method === data.brewMethod);

// Related: same category first, then same brew method, never itself.
const related = [
  ...all.filter((r) => r.id !== recipe.id && r.data.category === data.category),
  ...all.filter(
    (r) =>
      r.id !== recipe.id &&
      r.data.category !== data.category &&
      r.data.brewMethod === data.brewMethod,
  ),
].slice(0, 3);

// Absolute URL for social cards and structured data.
const ogImagePath = photo(data.image).src;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const recipeUrl = `${site}/recipes/${recipe.id}/`;
const shortUrl = recipeUrl.replace(/^https?:\/\//, '');
const share = shareText(data, extractSteps(recipe.body ?? ''), recipeUrl);
---

<Layout
  title={data.seoTitle ?? `${data.title} Recipe — KAVOVO`}
  description={data.seoDescription ?? data.description}
  ogImage={ogImagePath}
>
  <article class="recipe mx-auto max-w-3xl px-5 py-12">
    <RecipeSchema recipe={recipe} />

    <div class="hidden print:mb-6 print:block">
      <img src="/images/kavovo-lockup.svg" alt="KAVOVO" width="1191" height="156" class="h-5 w-auto" />
    </div>
    <Breadcrumbs
      trail={[
        { label: 'Recipes', href: '/recipes/' },
        { label: categoryLabel(data.category), href: categoryPath(data.category) },
        { label: data.title },
      ]}
    />

    <span class="eyebrow mt-6 block">
      <a href={categoryPath(data.category)} class="hover:underline">{categoryLabel(data.category)}</a>
    </span>
    <h1 class="mt-2 font-display text-4xl font-medium text-balance">{data.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{data.description}</p>

    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-ink-soft">
      <span>By {data.author}</span>
      <span aria-hidden="true">·</span>
      <span>
        Updated <time datetime={data.dateModified.toISOString()}>{dateFmt(data.dateModified)}</time>
      </span>
      <span class="ml-auto flex items-center gap-2 print:hidden">
        <button
          type="button"
          data-share
          data-share-text={share}
          data-share-url={recipeUrl}
          class="rounded-md border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors hover:border-accent"
        >
          Share recipe
        </button>
        <button
          type="button"
          data-print
          class="rounded-md border border-line px-3 py-1.5 text-xs font-medium text-ink transition-colors hover:border-accent"
        >
          Print recipe
        </button>
        <span data-share-status role="status" aria-live="polite" class="text-xs text-accent"></span>
      </span>
    </div>

    <Photo
      name={data.image}
      alt={data.title}
      sizes="(min-width: 768px) 768px, 100vw"
      class="mt-8 aspect-[16/9] w-full rounded-lg object-cover print:hidden"
      loading="eager"
      fetchpriority="high"
    />

    <dl class="mt-8 grid grid-cols-2 gap-4 rounded-lg border border-line bg-card p-5 sm:grid-cols-4">
      {facts.map(([label, value]) => (
        <div>
          <dt class="eyebrow">{label}</dt>
          <dd class="mt-1 text-sm font-medium">{value}</dd>
        </div>
      ))}
    </dl>

    {
      data.totalTimeLabel && (
        <p class="mt-3 text-sm text-ink-soft">
          Hands-on {humanDuration(data.activeTime)}; the rest is unattended brewing.
        </p>
      )
    }

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section class="recipe-block">
        <h2 class="font-display text-xl font-medium">Ingredients</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {data.ingredients.map((item) => (
            <li class="border-b border-line pb-2">{item}</li>
          ))}
        </ul>
      </section>
      <section class="recipe-block">
        <h2 class="font-display text-xl font-medium">Equipment</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {equipment.map((item) => (
            <li class="border-b border-line pb-2">{item}</li>
          ))}
        </ul>
        {
          data.equipmentOptional.length > 0 && (
            <>
              <h3 class="eyebrow mt-4">Optional</h3>
              <ul class="mt-2 flex flex-col gap-2 text-sm text-ink-soft">
                {data.equipmentOptional.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    </div>

    <p class="mt-6 hidden text-sm text-ink-soft print:block">
      Serve in a {data.vessel.name.toLowerCase()} ({data.vessel.capacity}). Full recipe: {shortUrl}
    </p>

    <div
      id="recipe-body"
      class="prose-recipe mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-medium [&_h3]:mt-6 [&_h3]:mb-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:flex [&_ol]:flex-col [&_ol]:gap-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_li]:text-ink-soft [&_p]:mt-4 [&_p]:text-ink-soft [&_p]:leading-relaxed [&_strong]:font-medium [&_strong]:text-ink"
    >
      <Content />
    </div>

    {
      guide && (
        <aside class="mt-10 rounded-lg border border-line bg-card p-5 print:hidden">
          <p class="text-sm text-ink-soft">
            New to this method? The
            <a href={`/guides/${guide.id}/`} class="font-medium text-accent hover:underline">
              {guide.data.title} brew guide
            </a>
            covers the technique behind this recipe.
          </p>
        </aside>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-line pt-8 print:hidden">
          <h2 class="font-display text-2xl font-medium">Related recipes</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {related.map((r) => (
              <RecipeCard
                slug={r.id}
                title={r.data.title}
                image={r.data.image}
                category={r.data.category}
                activeTime={r.data.activeTime}
                totalTime={r.data.totalTime}
                totalTimeLabel={r.data.totalTimeLabel}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>

<style is:global>
  /* Numbered steps double as a checklist you can tick while brewing. */
  #recipe-body ol {
    counter-reset: step;
    padding-left: 0;
  }
  #recipe-body ol > li {
    list-style: none;
    counter-increment: step;
    position: relative;
    padding-left: 2.25rem;
    cursor: pointer;
  }
  #recipe-body ol > li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05em;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  #recipe-body ol > li[data-done='true'] {
    opacity: 0.55;
    text-decoration: line-through;
  }
  #recipe-body ol > li[data-done='true']::before {
    content: '✓';
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-ivory);
    text-decoration: none;
  }

  @media print {
    /* Everything that is navigation, promotion or decoration goes away:
       what prints is the recipe you stand in the kitchen with. */
    header,
    footer,
    nav,
    form[role='search'],
    .print-hide {
      display: none !important;
    }

    body {
      background: #fff;
      color: #000;
    }

    .recipe {
      max-width: none;
      padding: 0;
    }

    /* Keep a block on one page rather than splitting it across two. */
    .recipe-block,
    #recipe-body li,
    #recipe-body h2,
    #recipe-body h3 {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    #recipe-body h2,
    #recipe-body h3 {
      break-after: avoid;
      page-break-after: avoid;
    }

    #recipe-body ol > li::before {
      border-color: #999;
    }

    a[href]::after {
      content: '';
    }
  }
</style>

<script>
  const body = document.getElementById('recipe-body');

  body?.querySelectorAll('ol > li').forEach((li) => {
    const item = li as HTMLElement;
    item.setAttribute('role', 'button');
    item.setAttribute('tabindex', '0');
    item.setAttribute('aria-pressed', 'false');

    const toggle = () => {
      const done = item.dataset.done === 'true';
      item.dataset.done = done ? 'false' : 'true';
      item.setAttribute('aria-pressed', done ? 'false' : 'true');
    };

    item.addEventListener('click', toggle);
    item.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ') {
        event.preventDefault();
        toggle();
      }
    });
  });

  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Share: the system sheet where it exists, clipboard everywhere else.
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');

  function announce(message: string) {
    if (!shareStatus) return;
    shareStatus.textContent = message;
    window.setTimeout(() => {
      shareStatus.textContent = '';
    }, 3000);
  }

  shareButton?.addEventListener('click', async () => {
    const text = shareButton.dataset.shareText ?? '';
    const url = shareButton.dataset.shareUrl ?? window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, text, url });
        return;
      } catch (error) {
        // Cancelling the sheet is not a failure; anything else falls through.
        if ((error as DOMException)?.name === 'AbortError') return;
      }
    }

    try {
      await navigator.clipboard.writeText(text);
      announce('Recipe copied!');
    } catch {
      announce('Could not copy — select and copy the page instead.');
    }
  });
</script>
