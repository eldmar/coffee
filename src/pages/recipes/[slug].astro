---
import { getCollection, render } from 'astro:content';
import Photo from '../../components/Photo.astro';
import { photo } from '../../lib/photos';
import Layout from '../../layouts/Layout.astro';
import RelatedContentCard from '../../components/RelatedContentCard.astro';
import RecipeSchema from '../../components/RecipeSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecipeExperience from '../../components/RecipeExperience.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import {
  categoryLabel,
  categoryPath,
  extractFaqs,
  extractSteps,
  formatTimeShort,
  humanDuration,
  recipeFacts,
  shareText,
} from '../../lib/recipes';
import { equipmentFor } from '../../lib/equipment';
import RecipeScaler from '../../components/RecipeScaler';
import { formatIngredients } from '../../lib/recipe-scaling';
import { selectRelatedRecipeSlugs } from '../../lib/related-content';
import { pathBySlug, readingMinutes } from '../../lib/learn';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
  }));
}

const all = await getCollection('recipes');
const recipe = all.find((candidate) => candidate.id === Astro.params.slug);
if (!recipe) throw new Error(`Recipe "${Astro.params.slug}" was not found.`);
const { Content } = await render(recipe);
const { data } = recipe;

const facts = recipeFacts(data);
const equipment = [...equipmentFor(data.equipmentSet), ...data.equipmentExtra];

const [guides, lessons, journalPosts] = await Promise.all([
  getCollection('guides'),
  getCollection('lessons'),
  getCollection('journal'),
]);
const guide = guides.find((g) => g.data.method === data.brewMethod);

const recipeSelectionData = all.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  brewMethod: entry.data.brewMethod,
  temperature: entry.data.temperature,
  milk: entry.data.milk,
  ingredientNames: entry.data.ingredients.map((ingredient) => ingredient.name),
  seasonalTags: entry.data.seasonalTags,
  popular: entry.data.popular,
}));
const sourceSelectionData = recipeSelectionData.find((entry) => entry.slug === recipe.id)!;
const manualRecipeSlugs = data.related?.recipes ?? data.relatedRecipes ?? [];
for (const slug of manualRecipeSlugs) {
  if (!all.some((candidate) => candidate.id === slug)) {
    throw new Error(`Recipe "${recipe.id}" links to missing related recipe "${slug}".`);
  }
}

const hasPublishedCategoryPeer = all.some(
  (candidate) => candidate.id !== recipe.id && candidate.data.category === data.category,
);
const useCategoryFallback = data.category === 'coffee-cocktails' && !hasPublishedCategoryPeer;
const selectedRecipeSlugs = selectRelatedRecipeSlugs(
  sourceSelectionData,
  recipeSelectionData,
  manualRecipeSlugs,
  useCategoryFallback ? 1 : 2,
);
const selectedRecipes = selectedRecipeSlugs.map((slug) => all.find((entry) => entry.id === slug)!);

const findLesson = (slug: string) =>
  lessons.find((lesson) => lesson.id === slug || lesson.id.endsWith(`/${slug}`));
const manualLessons = (data.related?.learn ?? []).map((slug) => {
  const lesson = findLesson(slug);
  if (!lesson) throw new Error(`Recipe "${recipe.id}" links to missing Learn item "${slug}".`);
  return lesson;
});
const educational: Array<
  | { kind: 'guide'; entry: (typeof guides)[number] }
  | { kind: 'learn'; entry: (typeof lessons)[number] }
> = [];
const educationIds = new Set<string>();
const addLesson = (entry: (typeof lessons)[number] | undefined) => {
  if (!entry || educationIds.has(`learn:${entry.id}`)) return;
  educationIds.add(`learn:${entry.id}`);
  educational.push({ kind: 'learn', entry });
};
const addGuide = (entry: (typeof guides)[number] | undefined) => {
  if (!entry || educationIds.has(`guide:${entry.id}`)) return;
  educationIds.add(`guide:${entry.id}`);
  educational.push({ kind: 'guide', entry });
};

manualLessons.forEach(addLesson);
if (manualLessons.length === 0) addGuide(guide);
const automaticLessonIds = [
  ...(data.temperature === 'iced' ? ['coffee-basics/cold-brew-vs-iced-coffee'] : []),
  ...(data.category === 'milk-drinks' ? ['coffee-basics/cortado-vs-flat-white-vs-latte'] : []),
  ...(data.brewMethod === 'espresso'
    ? ['dial-in-espresso/espresso-ratio', 'dial-in-espresso/espresso-basics-dose-yield-time']
    : []),
  ...(data.brewMethod === 'filter' || data.brewMethod === 'v60'
    ? ['coffee-basics/filter-coffee']
    : []),
  'coffee-basics/coffee-to-water-ratio',
  'coffee-basics/why-water-matters',
];
automaticLessonIds.forEach((id) => addLesson(findLesson(id)));
if (manualLessons.length > 0) addGuide(guide);

const manualJournal = (data.related?.journal ?? []).map((slug) => {
  const post = journalPosts.find((candidate) => candidate.id === slug);
  if (!post) throw new Error(`Recipe "${recipe.id}" links to missing Journal item "${slug}".`);
  return post;
});
const relevantJournal =
  manualJournal[0] ??
  (data.temperature === 'iced'
    ? journalPosts.find((post) => post.id === 'ice-is-an-ingredient')
    : undefined);
const educationNeeded = relevantJournal ? 1 : 2;

type RelatedCard = {
  href: string;
  title: string;
  type: 'recipe' | 'guide' | 'learn' | 'journal' | 'collection';
  typeLabel: string;
  category: string;
  image: string;
  imageAlt: string;
  time: string;
  contentSlug: string;
};

const relatedCards: RelatedCard[] = [];
if (useCategoryFallback) {
  relatedCards.push({
    href: categoryPath(data.category),
    title: `${categoryLabel(data.category)} recipes`,
    type: 'collection',
    typeLabel: 'Recipe collection',
    category: categoryLabel(data.category),
    image: data.image,
    imageAlt: data.imageAlt,
    time: 'Browse the collection',
    contentSlug: data.category,
  });
}
selectedRecipes.forEach((entry) => {
  relatedCards.push({
    href: `/recipes/${entry.id}/`,
    title: entry.data.title,
    type: 'recipe',
    typeLabel: 'Recipe',
    category: categoryLabel(entry.data.category),
    image: entry.data.image,
    imageAlt: entry.data.imageAlt,
    time: formatTimeShort(entry.data),
    contentSlug: entry.id,
  });
});

const pathImage: Record<string, string> = {
  'coffee-basics': 'learn-basics',
  'dial-in-espresso': 'learn-espresso',
  'understand-your-beans': 'learn-beans',
};
educational.slice(0, educationNeeded).forEach((item) => {
  if (item.kind === 'guide') {
    const canonical = all.find((entry) => entry.id === item.entry.data.canonicalRecipe);
    if (!canonical) return;
    relatedCards.push({
      href: `/guides/${item.entry.id}/`,
      title: item.entry.data.title,
      type: 'guide',
      typeLabel: 'Brew guide',
      category: item.entry.data.difficulty,
      image: canonical.data.image,
      imageAlt: canonical.data.imageAlt,
      time: `${readingMinutes(item.entry.data.readingTime)} read`,
      contentSlug: item.entry.id,
    });
    return;
  }
  const pathTitle = pathBySlug(item.entry.data.path)?.title ?? 'Learn';
  relatedCards.push({
    href: `/learn/${item.entry.id}/`,
    title: item.entry.data.title,
    type: 'learn',
    typeLabel: 'Learn',
    category: pathTitle,
    image: item.entry.data.image ?? pathImage[item.entry.data.path] ?? 'hero',
    imageAlt:
      item.entry.data.imageAlt ?? `Coffee brewing scene for the ${pathTitle} learning path.`,
    time: `${readingMinutes(item.entry.data.readingTime)} read`,
    contentSlug: item.entry.id.split('/').at(-1)!,
  });
});
if (relevantJournal) {
  relatedCards.push({
    href: `/journal/${relevantJournal.id}/`,
    title: relevantJournal.data.title,
    type: 'journal',
    typeLabel: 'Journal',
    category: relevantJournal.data.category ?? 'Journal',
    image: relevantJournal.data.image ?? 'hero',
    imageAlt: relevantJournal.data.imageAlt ?? 'A KAVOVO Journal coffee story.',
    time: `${readingMinutes(relevantJournal.data.readingTime ?? 1)} read`,
    contentSlug: relevantJournal.id,
  });
}

// Absolute URL for social cards and structured data.
const ogImagePath = data.ogImage ?? photo(data.image).src;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const recipeUrl = `${site}/recipes/${recipe.id}/`;
const shortUrl = recipeUrl.replace(/^https?:\/\//, '');
const steps = extractSteps(recipe.body ?? '');
const faqs = extractFaqs(recipe.body ?? '');
const share = shareText(data, steps, recipeUrl);
const usesScrollableTables = recipe.id === 'iced-americano';
const initialIngredientLines = formatIngredients(
  data.ingredients,
  { servings: 1, units: 'metric', ...(data.espresso ? { dose: data.espresso.dose } : {}) },
  data.espresso,
);
---

<Layout
  title={data.seoTitle ?? `${data.title} Recipe — KAVOVO`}
  description={data.seoDescription ?? data.description}
  ogImage={ogImagePath}
  ogType="article"
  publishedTime={data.datePublished}
  modifiedTime={data.dateModified}
>
  <article class="recipe mx-auto max-w-3xl px-5 py-12" data-recipe-slug={recipe.id}>
    <RecipeSchema recipe={recipe} />

    <div class="hidden print:mb-6 print:block">
      <img src="/images/kavovo-lockup.svg" alt="KAVOVO" width="1191" height="156" class="h-5 w-auto" />
    </div>
    <Breadcrumbs
      trail={[
        { label: 'Recipes', href: '/recipes/' },
        { label: categoryLabel(data.category), href: categoryPath(data.category) },
        { label: data.title },
      ]}
    />

    <span class="eyebrow mt-6 block">
      <a href={categoryPath(data.category)} class="hover:underline">{categoryLabel(data.category)}</a>
    </span>
    <h1 class="mt-2 font-display text-4xl font-medium text-balance">{data.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{data.description}</p>

    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-ink-soft">
      <span>By {data.author}</span>
      <span aria-hidden="true">·</span>
      <span>
        Updated <time datetime={data.dateModified.toISOString()}>{dateFmt(data.dateModified)}</time>
      </span>
      <span class="ml-auto flex flex-wrap items-center justify-end gap-2 print:hidden">
        <button type="button" data-save-recipe aria-pressed="false" aria-label={`Save ${data.title} recipe`} class="recipe-action recipe-action--secondary">
          <svg data-save-icon width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 4.8A1.8 1.8 0 0 1 7.8 3h8.4A1.8 1.8 0 0 1 18 4.8V21l-6-3.8L6 21Z" />
          </svg>
          <span data-save-label>Save recipe</span>
        </button>
        <button type="button" data-share data-share-text={share} data-share-url={recipeUrl} class="recipe-action recipe-action--primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" />
          </svg>
          Share recipe
        </button>
        <button type="button" data-print class="recipe-action recipe-action--secondary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9V3h12v6" />
            <path d="M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" />
            <rect x="6" y="14" width="12" height="7" rx="1" />
          </svg>
          Print recipe
        </button>
        <a data-view-saved href="/saved/" hidden class="min-h-11 items-center px-2 text-sm font-medium text-accent hover:underline">
          View saved
        </a>
        <span data-save-status role="status" aria-live="polite" hidden class="save-toast"></span>
        <span data-share-status role="status" aria-live="polite" class="text-xs font-medium text-accent"></span>
      </span>
    </div>

    {
      data.notice && (
        <p class="mt-6 rounded-md border border-accent/40 bg-accent/5 px-4 py-3 text-sm font-medium text-ink">
          {data.notice}
        </p>
      )
    }

    <Photo
      name={data.image}
      alt={data.imageAlt}
      sizes="(min-width: 768px) 768px, 100vw"
      class="mt-8 aspect-[16/9] w-full rounded-lg object-cover print:hidden"
      loading="eager"
      fetchpriority="high"
    />

    <dl
      class="mt-8 grid grid-cols-2 gap-4 rounded-lg border border-line bg-card p-5 sm:grid-cols-4"
      data-recipe-facts
    >
      {facts.map(([label, value]) => (
        <div>
          <dt class="eyebrow">{label}</dt>
          <dd class="mt-1 text-sm font-medium" data-recipe-measurement data-fact-label={label}>{value}</dd>
        </div>
      ))}
    </dl>

    {
      data.totalTimeLabel && (
        <p class="mt-3 text-sm text-ink-soft">
          Hands-on {humanDuration(data.activeTime)}; the rest is unattended brewing.
        </p>
      )
    }

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <RecipeScaler
        client:load
        recipeSlug={recipe.id}
        ingredients={data.ingredients}
        espresso={data.espresso}
        servingNote={data.cupScaling?.note}
      />
      <section class="recipe-block">
        <h2 class="font-display text-xl font-medium">Equipment</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {equipment.map((item) => (
            <li class="border-b border-line pb-2">{item}</li>
          ))}
        </ul>
        {
          data.equipmentOptional.length > 0 && (
            <>
              <h3 class="eyebrow mt-4">Optional</h3>
              <ul class="mt-2 flex flex-col gap-2 text-sm text-ink-soft">
                {data.equipmentOptional.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    </div>

    <p class="mt-6 hidden text-sm text-ink-soft print:block">
      Serve in a {data.vessel.name.toLowerCase()} ({data.vessel.capacity}). Full recipe: {shortUrl}
    </p>

    <RecipeExperience
      title={data.title}
      steps={steps}
      ingredients={initialIngredientLines}
      espresso={data.espresso}
    />

    <div
      id="recipe-body"
      class:list={[
        'prose-body prose-recipe mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-medium [&_h3]:mt-6 [&_h3]:mb-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:flex [&_ol]:flex-col [&_ol]:gap-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_li]:text-ink-soft [&_p]:mt-4 [&_p]:text-ink-soft [&_p]:leading-relaxed [&_strong]:font-medium [&_strong]:text-ink',
        usesScrollableTables && 'prose-comparison',
      ]}
      data-scrollable-tables={usesScrollableTables ? '' : undefined}
    >
      <Content />
    </div>

    <FaqSchema items={faqs} />

    <section class="mt-12 border-t border-line pt-8 print:hidden" aria-labelledby="related-content-heading">
      <span class="eyebrow">Continue exploring</span>
      <h2 id="related-content-heading" class="mt-2 font-display text-2xl font-medium">
        Related recipes and guides
      </h2>
      <ul class="related-content-list mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-3 md:grid md:grid-cols-2 md:overflow-visible md:pb-0">
        {relatedCards.map((card) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-[46%] md:w-auto">
            <RelatedContentCard {...card} sourceRecipe={recipe.id} />
          </li>
        ))}
      </ul>
    </section>
  </article>
</Layout>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('.prose-recipe table')) {
    if (table.closest('[data-scrollable-tables]')) {
      table.tabIndex = 0;
      table.setAttribute('aria-label', 'Scrollable comparison table');
      const hint = document.createElement('p');
      hint.className = 'table-scroll-hint';
      hint.setAttribute('aria-hidden', 'true');
      hint.textContent = 'Swipe to compare →';
      table.before(hint);
      continue;
    }
    const labels = [...table.querySelectorAll('thead th')].map((heading) =>
      heading.textContent?.trim() ?? '',
    );
    if (labels.length === 0) continue;
    for (const row of table.querySelectorAll('tbody tr')) {
      [...row.children].forEach((cell, index) => {
        if (labels[index]) cell.setAttribute('data-label', labels[index]);
      });
    }
  }
</script>

<style is:global>
  /* The two things you actually do with a recipe, made to look clickable. */
  .recipe-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .recipe-action--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .recipe-action--primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    box-shadow: 0 4px 10px rgb(43 33 27 / 0.16);
    transform: translateY(-1px);
  }

  .recipe-action--secondary {
    background: var(--color-card);
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .recipe-action--secondary:hover {
    background: var(--color-ivory);
    border-color: var(--color-accent);
    box-shadow: 0 4px 10px rgb(43 33 27 / 0.12);
    transform: translateY(-1px);
  }

  .recipe-action:active {
    transform: translateY(0);
  }

  .recipe-action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .save-toast {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    max-width: min(22rem, calc(100vw - 2rem));
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    background: var(--color-ink);
    color: var(--color-card);
    box-shadow: 0 10px 30px rgb(43 33 27 / 0.2);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .related-content-list {
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
    scroll-padding-inline: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-action {
      transition: none;
    }
    .recipe-action:hover {
      transform: none;
    }
  }

  @media print {
    /* Everything that is navigation, promotion or decoration goes away:
       what prints is the recipe you stand in the kitchen with. */
    header,
    footer,
    nav,
    form[role='search'],
    .print-hide {
      display: none !important;
    }

    body {
      background: #fff;
      color: #000;
    }

    .recipe {
      max-width: none;
      padding: 0;
    }

    /* Keep a block on one page rather than splitting it across two. */
    .recipe-block,
    #recipe-body li,
    #recipe-body h2,
    #recipe-body h3 {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    #recipe-body h2,
    #recipe-body h3 {
      break-after: avoid;
      page-break-after: avoid;
    }

    a[href]::after {
      content: '';
    }
  }
</style>

<script>
  import { trackRetentionEvent } from '../../lib/analytics';
  import { recipeShareUrl, type RecipeSettings } from '../../lib/recipe-scaling';
  import {
    RETENTION_KEYS,
    isRecipeSaved,
    recordRecentRecipe,
    subscribeRetentionKey,
    toggleSavedRecipe,
  } from '../../lib/retention/storage';

  const recipeRoot = document.querySelector<HTMLElement>('[data-recipe-slug]');
  const recipeSlug = recipeRoot?.dataset.recipeSlug;
  const saveButton = document.querySelector<HTMLButtonElement>('[data-save-recipe]');
  const saveLabel = document.querySelector<HTMLElement>('[data-save-label]');
  const saveIcon = document.querySelector<SVGElement>('[data-save-icon]');
  const viewSaved = document.querySelector<HTMLAnchorElement>('[data-view-saved]');
  const saveStatus = document.querySelector<HTMLElement>('[data-save-status]');

  function refreshSaveButton() {
    if (!recipeSlug || !saveButton || !saveLabel) return;
    const saved = isRecipeSaved(recipeSlug);
    saveButton.setAttribute('aria-pressed', String(saved));
    saveButton.setAttribute(
      'aria-label',
      saved ? `Remove ${document.querySelector('h1')?.textContent?.trim() ?? 'recipe'} from saved recipes` : `Save ${document.querySelector('h1')?.textContent?.trim() ?? 'recipe'} recipe`,
    );
    saveLabel.textContent = saved ? 'Saved ✓' : 'Save recipe';
    saveIcon?.setAttribute('fill', saved ? 'currentColor' : 'none');
    if (viewSaved) {
      viewSaved.hidden = !saved;
      viewSaved.classList.toggle('inline-flex', saved);
    }
  }

  if (recipeSlug) {
    recordRecentRecipe(recipeSlug);
    refreshSaveButton();
    subscribeRetentionKey(RETENTION_KEYS.savedRecipes, refreshSaveButton);
  }

  saveButton?.addEventListener('click', () => {
    if (!recipeSlug) return;
    const saved = toggleSavedRecipe(recipeSlug);
    trackRetentionEvent(saved ? 'recipe_saved' : 'recipe_removed', { recipe_slug: recipeSlug });
    if (saveStatus) {
      saveStatus.textContent = saved ? 'Recipe saved on this device.' : 'Recipe removed from saved.';
      saveStatus.hidden = false;
      window.setTimeout(() => {
        saveStatus.hidden = true;
      }, 3000);
    }
  });

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-related-content]')) {
    link.addEventListener('click', () => {
      const contentType = link.dataset.contentType;
      const contentSlug = link.dataset.contentSlug;
      const sourceRecipe = link.dataset.sourceRecipe;
      if (
        !sourceRecipe ||
        !contentSlug ||
        !contentType ||
        !['recipe', 'guide', 'learn', 'journal'].includes(contentType)
      ) {
        return;
      }
      trackRetentionEvent('related_content_clicked', {
        recipe_slug: sourceRecipe,
        content_type: contentType as 'recipe' | 'guide' | 'learn' | 'journal',
        content_slug: contentSlug,
      });
    });
  }

  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Share: the system sheet where it exists, clipboard everywhere else.
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');

  function announce(message: string) {
    if (!shareStatus) return;
    shareStatus.textContent = message;
    window.setTimeout(() => {
      shareStatus.textContent = '';
    }, 3000);
  }

  async function copyShareText(text: string): Promise<boolean> {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // A local fallback still works when clipboard permissions are denied.
      }
    }

    const field = document.createElement('textarea');
    field.value = text;
    field.readOnly = true;
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.append(field);
    field.select();
    field.setSelectionRange(0, field.value.length);

    try {
      return document.execCommand('copy');
    } finally {
      field.remove();
      shareButton?.focus();
    }
  }

  shareButton?.addEventListener('click', async () => {
    const text = shareButton.dataset.shareText ?? '';
    const baseUrl = shareButton.dataset.shareUrl ?? window.location.href;
    const scaler = document.querySelector<HTMLElement>('[data-recipe-scaler]');
    const experience = document.querySelector<HTMLElement>('[data-recipe-experience]');
    const servingsValue = Number(scaler?.dataset.servings);
    const unitsValue = scaler?.dataset.units;
    const doseValue = Number(scaler?.dataset.dose);
    const settings: RecipeSettings = {
      servings: servingsValue === 2 || servingsValue === 3 ? servingsValue : 1,
      units: unitsValue === 'us' ? 'us' : 'metric',
      ...(Number.isFinite(doseValue) ? { dose: doseValue } : {}),
    };
    const baseDose = Number(experience?.dataset.espressoDose);
    const ratio = Number(experience?.dataset.espressoRatio);
    const espresso = Number.isFinite(baseDose) && Number.isFinite(ratio)
      ? { dose: baseDose, ratio }
      : undefined;
    const url = recipeShareUrl(baseUrl, settings, espresso);

    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, text, url });
        return;
      } catch (error) {
        // Cancelling the sheet is not a failure; anything else falls through.
        if ((error as DOMException)?.name === 'AbortError') return;
      }
    }

    const copied = await copyShareText(text);
    announce(copied ? 'Recipe copied!' : 'Could not copy — select and copy the page instead.');
  });
</script>
