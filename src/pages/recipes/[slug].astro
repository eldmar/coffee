---
import { getCollection, render } from 'astro:content';
import Photo from '../../components/Photo.astro';
import { photo } from '../../lib/photos';
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import RecipeSchema from '../../components/RecipeSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecipeExperience from '../../components/RecipeExperience.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import {
  categoryLabel,
  categoryPath,
  extractFaqs,
  extractSteps,
  humanDuration,
  recipeFacts,
  shareText,
} from '../../lib/recipes';
import { equipmentFor } from '../../lib/equipment';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
  }));
}

const all = await getCollection('recipes');
const recipe = all.find((candidate) => candidate.id === Astro.params.slug);
if (!recipe) throw new Error(`Recipe "${Astro.params.slug}" was not found.`);
const { Content } = await render(recipe);
const { data } = recipe;

const facts = recipeFacts(data);
const equipment = [...equipmentFor(data.equipmentSet), ...data.equipmentExtra];

const guides = await getCollection('guides');
const guide = guides.find((g) => g.data.method === data.brewMethod);

// Related recipes are automatic unless editorially pinned in frontmatter.
const automaticRelated = [
  ...all.filter((r) => r.id !== recipe.id && r.data.category === data.category),
  ...all.filter(
    (r) =>
      r.id !== recipe.id &&
      r.data.category !== data.category &&
      r.data.brewMethod === data.brewMethod,
  ),
].slice(0, 3);
const related = data.relatedRecipes
  ? data.relatedRecipes.map((slug) => {
      const match = all.find((candidate) => candidate.id === slug);
      if (!match) throw new Error(`Recipe "${recipe.id}" links to missing related recipe "${slug}".`);
      return match;
    })
  : automaticRelated;

// Absolute URL for social cards and structured data.
const ogImagePath = data.ogImage ?? photo(data.image).src;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const recipeUrl = `${site}/recipes/${recipe.id}/`;
const shortUrl = recipeUrl.replace(/^https?:\/\//, '');
const steps = extractSteps(recipe.body ?? '');
const faqs = extractFaqs(recipe.body ?? '');
const share = shareText(data, steps, recipeUrl);
const usesScrollableTables = recipe.id === 'iced-americano';
---

<Layout
  title={data.seoTitle ?? `${data.title} Recipe — KAVOVO`}
  description={data.seoDescription ?? data.description}
  ogImage={ogImagePath}
  ogType="article"
  publishedTime={data.datePublished}
  modifiedTime={data.dateModified}
>
  <article class="recipe mx-auto max-w-3xl px-5 py-12">
    <RecipeSchema recipe={recipe} />

    <div class="hidden print:mb-6 print:block">
      <img src="/images/kavovo-lockup.svg" alt="KAVOVO" width="1191" height="156" class="h-5 w-auto" />
    </div>
    <Breadcrumbs
      trail={[
        { label: 'Recipes', href: '/recipes/' },
        { label: categoryLabel(data.category), href: categoryPath(data.category) },
        { label: data.title },
      ]}
    />

    <span class="eyebrow mt-6 block">
      <a href={categoryPath(data.category)} class="hover:underline">{categoryLabel(data.category)}</a>
    </span>
    <h1 class="mt-2 font-display text-4xl font-medium text-balance">{data.title}</h1>
    <p class="mt-4 text-lg text-ink-soft">{data.description}</p>

    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm text-ink-soft">
      <span>By {data.author}</span>
      <span aria-hidden="true">·</span>
      <span>
        Updated <time datetime={data.dateModified.toISOString()}>{dateFmt(data.dateModified)}</time>
      </span>
      <span class="ml-auto flex items-center gap-2 print:hidden">
        <button type="button" data-share data-share-text={share} data-share-url={recipeUrl} class="recipe-action recipe-action--primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" />
          </svg>
          Share recipe
        </button>
        <button type="button" data-print class="recipe-action recipe-action--secondary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9V3h12v6" />
            <path d="M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" />
            <rect x="6" y="14" width="12" height="7" rx="1" />
          </svg>
          Print recipe
        </button>
        <span data-share-status role="status" aria-live="polite" class="text-xs font-medium text-accent"></span>
      </span>
    </div>

    {
      data.notice && (
        <p class="mt-6 rounded-md border border-accent/40 bg-accent/5 px-4 py-3 text-sm font-medium text-ink">
          {data.notice}
        </p>
      )
    }

    <Photo
      name={data.image}
      alt={data.imageAlt}
      sizes="(min-width: 768px) 768px, 100vw"
      class="mt-8 aspect-[16/9] w-full rounded-lg object-cover print:hidden"
      loading="eager"
      fetchpriority="high"
    />

    <dl
      class="mt-8 grid grid-cols-2 gap-4 rounded-lg border border-line bg-card p-5 sm:grid-cols-4"
      data-recipe-facts
    >
      {facts.map(([label, value]) => (
        <div>
          <dt class="eyebrow">{label}</dt>
          <dd class="mt-1 text-sm font-medium" data-recipe-measurement>{value}</dd>
        </div>
      ))}
    </dl>

    {
      data.totalTimeLabel && (
        <p class="mt-3 text-sm text-ink-soft">
          Hands-on {humanDuration(data.activeTime)}; the rest is unattended brewing.
        </p>
      )
    }

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section class="recipe-block" data-recipe-ingredients>
        <h2 class="font-display text-xl font-medium">Ingredients</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {data.ingredients.map((item) => (
            <li class="border-b border-line pb-2">{item}</li>
          ))}
        </ul>
      </section>
      <section class="recipe-block">
        <h2 class="font-display text-xl font-medium">Equipment</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft">
          {equipment.map((item) => (
            <li class="border-b border-line pb-2">{item}</li>
          ))}
        </ul>
        {
          data.equipmentOptional.length > 0 && (
            <>
              <h3 class="eyebrow mt-4">Optional</h3>
              <ul class="mt-2 flex flex-col gap-2 text-sm text-ink-soft">
                {data.equipmentOptional.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    </div>

    <p class="mt-6 hidden text-sm text-ink-soft print:block">
      Serve in a {data.vessel.name.toLowerCase()} ({data.vessel.capacity}). Full recipe: {shortUrl}
    </p>

    <RecipeExperience
      title={data.title}
      steps={steps}
      baseCups={data.cupScaling?.baseCups}
      cupNote={data.cupScaling?.note}
      batchScaling={data.cupScaling?.batchScaling}
    />

    <div
      id="recipe-body"
      class:list={[
        'prose-body prose-recipe mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-medium [&_h3]:mt-6 [&_h3]:mb-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:flex [&_ol]:flex-col [&_ol]:gap-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_li]:text-ink-soft [&_p]:mt-4 [&_p]:text-ink-soft [&_p]:leading-relaxed [&_strong]:font-medium [&_strong]:text-ink',
        usesScrollableTables && 'prose-comparison',
      ]}
      data-scrollable-tables={usesScrollableTables ? '' : undefined}
    >
      <Content />
    </div>

    <FaqSchema items={faqs} />

    {
      guide && (
        <aside class="mt-10 rounded-lg border border-line bg-card p-5 print:hidden">
          <p class="text-sm text-ink-soft" data-recipe-guide-link>
            New to this method? The{' '}
            <a href={`/guides/${guide.id}/`} class="font-medium text-accent hover:underline">
              {guide.data.title} brew guide
            </a>{' '}
            covers the technique behind this recipe.
          </p>
        </aside>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-line pt-8 print:hidden">
          <h2 class="font-display text-2xl font-medium">Related recipes</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            {related.map((r) => (
              <RecipeCard
                slug={r.id}
                title={r.data.title}
                image={r.data.image}
                category={r.data.category}
                activeTime={r.data.activeTime}
                totalTime={r.data.totalTime}
                totalTimeLabel={r.data.totalTimeLabel}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('.prose-recipe table')) {
    if (table.closest('[data-scrollable-tables]')) {
      table.tabIndex = 0;
      table.setAttribute('aria-label', 'Scrollable comparison table');
      const hint = document.createElement('p');
      hint.className = 'table-scroll-hint';
      hint.setAttribute('aria-hidden', 'true');
      hint.textContent = 'Swipe to compare →';
      table.before(hint);
      continue;
    }
    const labels = [...table.querySelectorAll('thead th')].map((heading) =>
      heading.textContent?.trim() ?? '',
    );
    if (labels.length === 0) continue;
    for (const row of table.querySelectorAll('tbody tr')) {
      [...row.children].forEach((cell, index) => {
        if (labels[index]) cell.setAttribute('data-label', labels[index]);
      });
    }
  }
</script>

<style is:global>
  /* The two things you actually do with a recipe, made to look clickable. */
  .recipe-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .recipe-action--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .recipe-action--primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    box-shadow: 0 4px 10px rgb(43 33 27 / 0.16);
    transform: translateY(-1px);
  }

  .recipe-action--secondary {
    background: var(--color-card);
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .recipe-action--secondary:hover {
    background: var(--color-ivory);
    border-color: var(--color-accent);
    box-shadow: 0 4px 10px rgb(43 33 27 / 0.12);
    transform: translateY(-1px);
  }

  .recipe-action:active {
    transform: translateY(0);
  }

  .recipe-action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-action {
      transition: none;
    }
    .recipe-action:hover {
      transform: none;
    }
  }

  @media print {
    /* Everything that is navigation, promotion or decoration goes away:
       what prints is the recipe you stand in the kitchen with. */
    header,
    footer,
    nav,
    form[role='search'],
    .print-hide {
      display: none !important;
    }

    body {
      background: #fff;
      color: #000;
    }

    .recipe {
      max-width: none;
      padding: 0;
    }

    /* Keep a block on one page rather than splitting it across two. */
    .recipe-block,
    #recipe-body li,
    #recipe-body h2,
    #recipe-body h3 {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    #recipe-body h2,
    #recipe-body h3 {
      break-after: avoid;
      page-break-after: avoid;
    }

    a[href]::after {
      content: '';
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Share: the system sheet where it exists, clipboard everywhere else.
  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareStatus = document.querySelector<HTMLElement>('[data-share-status]');

  function announce(message: string) {
    if (!shareStatus) return;
    shareStatus.textContent = message;
    window.setTimeout(() => {
      shareStatus.textContent = '';
    }, 3000);
  }

  async function copyShareText(text: string): Promise<boolean> {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // A local fallback still works when clipboard permissions are denied.
      }
    }

    const field = document.createElement('textarea');
    field.value = text;
    field.readOnly = true;
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.append(field);
    field.select();
    field.setSelectionRange(0, field.value.length);

    try {
      return document.execCommand('copy');
    } finally {
      field.remove();
      shareButton?.focus();
    }
  }

  shareButton?.addEventListener('click', async () => {
    const text = shareButton.dataset.shareText ?? '';
    const url = shareButton.dataset.shareUrl ?? window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, text, url });
        return;
      } catch (error) {
        // Cancelling the sheet is not a failure; anything else falls through.
        if ((error as DOMException)?.name === 'AbortError') return;
      }
    }

    const copied = await copyShareText(text);
    announce(copied ? 'Recipe copied!' : 'Could not copy — select and copy the page instead.');
  });
</script>
