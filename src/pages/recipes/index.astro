---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeFilters from '../../components/RecipeFilters';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { CATEGORIES } from '../../lib/recipes';

const recipes = (await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const catalog = recipes.map((r) => ({
  slug: r.id,
  title: r.data.title,
  description: r.data.description,
  image: r.data.image,
  category: r.data.category,
  brewMethod: r.data.brewMethod,
  temperature: r.data.temperature,
  milk: r.data.milk,
  activeTime: r.data.activeTime,
  totalTime: r.data.totalTime,
  totalTimeLabel: r.data.totalTimeLabel,
  difficulty: r.data.difficulty,
  ingredients: r.data.ingredients,
}));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'All KAVOVO recipes',
  numberOfItems: recipes.length,
  itemListElement: recipes.map((r, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${site}/recipes/${r.id}/`,
    name: r.data.title,
  })),
};
---

<Layout
  title="Recipes — KAVOVO"
  description="Every recipe on KAVOVO: espresso drinks, milk drinks, filter coffee and iced coffee, with exact doses and times."
>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <JsonLd schema={schema} />
    <Breadcrumbs trail={[{ label: 'Recipes' }]} />

    <span class="eyebrow mt-6 block">Recipes</span>
    <h1 class="mt-2 font-display text-4xl font-medium">All recipes</h1>
    <p class="mt-3 max-w-lg text-ink-soft">
      Espresso drinks, pour overs, and cold coffee — each with exact doses, times, and fixes for when things go wrong.
    </p>

    <nav aria-label="Recipe categories" class="mt-8 flex flex-wrap gap-2">
      <span
        aria-current="page"
        class="rounded-md border border-accent bg-accent px-3.5 py-1.5 text-sm text-accent-ink"
      >
        All recipes
      </span>
      {
        CATEGORIES.map((c) => (
          <a
            href={`/recipes/${c.slug}/`}
            class="rounded-md border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:border-accent hover:text-ink"
          >
            {c.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-8">
      <RecipeFilters client:load recipes={catalog} />
    </div>
  </section>
</Layout>
