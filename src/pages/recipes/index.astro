---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeFilters from '../../components/RecipeFilters';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { CATEGORIES } from '../../lib/recipes';
import { cardImage } from '../../lib/cardImage';
import RecentlyViewed from '../../components/retention/RecentlyViewed';

const recipes = (await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const catalog = recipes.map((r) => ({
  slug: r.id,
  title: r.data.title,
  description: r.data.description,
  image: cardImage(r.data.image),
  category: r.data.category,
  brewMethod: r.data.brewMethod,
  temperature: r.data.temperature,
  milk: r.data.milk,
  activeTime: r.data.activeTime,
  totalTime: r.data.totalTime,
  totalTimeLabel: r.data.totalTimeLabel,
  ingredients: r.data.ingredients.flatMap((ingredient) => [
    ingredient.name,
    ingredient.note ?? '',
    ingredient.displayAmount ?? '',
  ]),
}));

const retentionRecipes = recipes.map((recipe) => ({
  slug: recipe.id,
  title: recipe.data.title,
  image: cardImage(recipe.data.image),
  imageAlt: recipe.data.imageAlt,
  category: recipe.data.category,
  activeTime: recipe.data.activeTime,
  totalTime: recipe.data.totalTime,
  totalTimeLabel: recipe.data.totalTimeLabel,
}));

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'All KAVOVO recipes',
  numberOfItems: recipes.length,
  itemListElement: recipes.map((r, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${site}/recipes/${r.id}/`,
    name: r.data.title,
  })),
};
---

<Layout
  title="Coffee Recipes: Espresso, Iced & Milk Drinks | KAVOVO"
  description="Every recipe on KAVOVO: espresso drinks, milk drinks, filter coffee and iced coffee, with exact doses and times."
  ogImage="/social/recipes.webp"
>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <JsonLd schema={schema} />
    <Breadcrumbs trail={[{ label: 'Recipes' }]} />

    <div class="mt-6 gap-8 sm:flex sm:items-end sm:justify-between">
      <div>
        <span class="eyebrow block">Recipes</span>
        <h1 class="mt-2 font-display text-4xl font-medium">All recipes</h1>
        <p class="mt-3 max-w-lg text-ink-soft">
          Espresso drinks, pour overs, and cold coffee — each with exact doses, times, and fixes for when things go wrong.
        </p>
      </div>
      <a
        href="/recipes/saved/"
        data-saved-link
        data-show-zero
        aria-label="Saved recipes, 0"
        class="mt-5 inline-flex min-h-11 shrink-0 items-center gap-2 rounded-md border border-line bg-card px-4 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent sm:mt-0"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 4.8A1.8 1.8 0 0 1 7.8 3h8.4A1.8 1.8 0 0 1 18 4.8V21l-6-3.8L6 21Z" />
        </svg>
        <span>Saved recipes</span>
        <span class="text-ink-soft" aria-hidden="true">(<span data-saved-count data-show-zero>0</span>)</span>
      </a>
    </div>

    <nav aria-label="Recipe categories" class="mt-8 flex flex-wrap gap-2">
      <span
        aria-current="page"
        class="rounded-md border border-accent bg-accent px-3.5 py-1.5 text-sm text-accent-ink"
      >
        All recipes
      </span>
      {
        CATEGORIES.map((c) => (
          <a
            href={`/recipes/${c.slug}/`}
            class="rounded-md border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:border-accent hover:text-ink"
          >
            {c.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-8">
      <RecipeFilters client:load recipes={catalog} />
    </div>

    <RecentlyViewed
      client:load
      recipes={retentionRecipes}
      className="mt-16 border-t border-line pt-10"
    />
  </section>
</Layout>
