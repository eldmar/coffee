---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shop — KAVOVO" description="Small-batch coffees selected to perform in your favorite brew methods. Coming soon.">
  <section class="mx-auto max-w-3xl px-5 py-20 text-center">
    <span class="eyebrow">Coming soon</span>
    <h1 class="mt-3 font-display text-4xl font-medium text-balance">Coffee chosen for the way you brew.</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">
      Small-batch coffees selected to perform in your favorite brew methods. Join the waitlist and be first to try the
      launch roasts.
    </p>
    <form method="post" action="/api/subscribe" class="mx-auto mt-8 flex max-w-sm flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="waitlist-email">Email address</label>
      <input
        id="waitlist-email"
        type="email"
        name="email"
        required
        placeholder="Your email address"
        class="flex-1 rounded-md border border-line bg-card px-4 py-2.5 text-sm transition-colors"
      />
      <button
        type="submit"
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
      >
        Join the waitlist
      </button>
    </form>
  </section>
</Layout>
