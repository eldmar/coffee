---
import Layout from '../layouts/Layout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const subscriptionsEnabled = import.meta.env.PUBLIC_SUBSCRIPTIONS_ENABLED === 'true';
---

<Layout
  title="Shop — KAVOVO"
  description="Small-batch coffees selected to perform in your favorite brew methods. Coming soon."
  noindex
>
  <section class="mx-auto max-w-3xl px-5 py-20 text-center">
    <span class="eyebrow">Coming soon</span>
    <h1 class="mt-3 font-display text-4xl font-medium text-balance">Coffee chosen for the way you brew.</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">
      {
        subscriptionsEnabled
          ? 'Small-batch coffees selected to perform in your favorite brew methods. Join the waitlist and be first to try the launch roasts.'
          : 'Small-batch coffees selected to perform in your favorite brew methods. Launch updates will appear here first.'
      }
    </p>
    {
      subscriptionsEnabled ? (
        <SubscribeForm
          id="shop-waitlist"
          source="shop-waitlist"
          submitLabel="Join the waitlist"
          containerClass="mx-auto mt-8 max-w-sm"
        />
      ) : (
        <p class="mt-8 text-sm font-medium text-accent">Shop coming soon.</p>
      )
    }
  </section>
</Layout>
