---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Subscription confirmed - KAVOVO"
  description="Your KAVOVO email subscription is confirmed."
  noindex
>
  <section class="mx-auto max-w-2xl px-5 py-20 text-center">
    <span class="eyebrow">Subscription confirmed</span>
    <h1 class="mt-3 font-display text-4xl font-medium text-balance">You are on the list.</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">
      Thanks for confirming. The next KAVOVO update will arrive in your inbox.
    </p>
    <a
      href="/recipes/"
      class="mt-8 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-dark"
    >
      Browse recipes
    </a>
  </section>
</Layout>
