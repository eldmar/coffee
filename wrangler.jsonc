{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kavovo.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.kavovo.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the routes the Worker actually answers, plus the pages its
    // canonical/legacy redirects have to intercept. Static assets used to bill
    // a Worker invocation each: one page view is ~25 of them against a single
    // HTML request, and none of them needed the Worker at all.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/img/*",
      "!/images/*",
      "!/social/*",
      "!/favicon.png",
      "!/apple-touch-icon.png",
      "!/robots.txt",
      "!/sitemap-index.xml",
      "!/sitemap-0.xml"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SITE_URL": "https://kavovo.uk"
  },
  "ratelimits": [
    {
      "name": "SUBSCRIBE_RATE_LIMITER",
      "namespace_id": "8010926",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIBE_IP_RATE_LIMITER",
      "namespace_id": "8010927",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
